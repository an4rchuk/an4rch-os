{
  "include": [
    {"vm": "b-1cpu-2gb", "cpus": 1, "mem": "2G", "xres": 1024, "yres": 768},
    {"vm": "b-800x600", "cpus": 2, "mem": "4G", "xres": 800, "yres": 600},
    {"vm": "b-ultrawide", "xres": 3440, "yres": 1440},
    {"vm": "b-offline-encrypted", "nonet": true, "install": "lumen.encrypt=lumenpass1 lumen.keymap=fr lumen.timezone=Europe/Paris", "bootpass": "lumenpass1"},
    {"vm": "b-offline-dualboot", "nonet": true, "windows": true, "install": "lumen.mode=alongside lumen.size=30"},
    {"vm": "b-offline-bios", "nonet": true, "bios": true, "cpus": 2, "mem": "4G"},
    {"vm": "b-offline-gamer", "nonet": true, "install": "lumen.gaming=1"},
    {"vm": "b-bios-encrypted", "bios": true, "install": "lumen.encrypt=lumenpass1", "bootpass": "lumenpass1"},
    {"vm": "b-spanish", "install": "lumen.keymap=es lumen.timezone=Europe/Madrid lumen.locale=es_ES.UTF-8"},
    {"vm": "b-dvorak", "install": "lumen.keymap=dvorak lumen.timezone=America/New_York"},
    {"vm": "b-japan", "install": "lumen.keymap=jp106 lumen.timezone=Asia/Tokyo lumen.locale=ja_JP.UTF-8"},
    {"vm": "b-swiss", "install": "lumen.keymap=de_CH-latin1 lumen.timezone=Europe/Zurich"},
    {"vm": "b-kitty-green", "install": "lumen.terminal=kitty lumen.theme=green-anarchism"},
    {"vm": "b-queer-notitlebars", "install": "lumen.theme=queer lumen.titlebars=0"},
    {"vm": "b-anfem-autologin", "install": "lumen.theme=anfem lumen.autologin=1"},
    {"vm": "b-dualboot-min", "windows": true, "install": "lumen.mode=alongside lumen.size=10"},
    {"vm": "b-dualboot-huge", "windows": true, "install": "lumen.mode=alongside lumen.size=500"},
    {"vm": "b-gamer-nvidia-lts", "install": "lumen.gaming=1 lumen.gpu=nvidia lumen.bootlts=1"},
    {"vm": "b-everything-off", "install": "lumen.taskbar=0 lumen.titlebars=0 lumen.theme=mutualism"},
    {"vm": "b-8cpu-16gb", "cpus": 8, "mem": "16G", "xres": 2560, "yres": 1440}
  ]
}
