#!/bin/bash
# lumen-greeter — An4rch's login screen, started by greetd as the "greeter"
# user (installed to /usr/local/bin by `anarch-login setup`).
#
# An4rch's own login screen (user name and password together, the logo where
# the boot screen leaves it) runs in the cage kiosk compositor, in your
# theme's colours (copied to /var/lib/lumen/login by `anarch-login sync`).
# If it can't start, ReGreet takes over, and failing that the text login
# screen (tuigreet), so you can always log in.
dir=/var/lib/lumen/login
session="uwsm start -- hyprland.desktop"
log="${XDG_RUNTIME_DIR:-/tmp}/lumen-greeter.log"

if [[ ! -e "$dir/text-only" ]] && command -v cage >/dev/null &&
  compgen -G '/dev/dri/card*' >/dev/null; then
  # An4rch's session files come first: ReGreet takes the first file of each
  # name, so the list shows one "an4rch" session (Hyprland through uwsm).
  export XDG_DATA_DIRS="/usr/local/share/lumen:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  # The system keyboard layout (set by the installer or anarch setup keyboard),
  # so passwords type the same as on the desktop.
  kbconf=/etc/X11/xorg.conf.d/00-keyboard.conf
  if [[ -f "$kbconf" ]]; then
    XKB_DEFAULT_LAYOUT=$(sed -n 's/.*"XkbLayout"[[:space:]]*"\([^"]*\)".*/\1/p' "$kbconf")
    XKB_DEFAULT_VARIANT=$(sed -n 's/.*"XkbVariant"[[:space:]]*"\([^"]*\)".*/\1/p' "$kbconf")
    export XKB_DEFAULT_LAYOUT XKB_DEFAULT_VARIANT
  fi
  args=()
  [[ -f "$dir/regreet.toml" ]] && args+=(--config "$dir/regreet.toml")
  [[ -f "$dir/regreet.css" ]] && args+=(--style "$dir/regreet.css")
  app=/usr/local/share/lumen/greeter/lumen_greeter.py
  if [[ -f "$app" ]] && python3 -c 'import gi; gi.require_version("Gtk", "4.0")' 2>/dev/null; then
    start=$SECONDS
    cage -s -m last -- python3 "$app" >"$log" 2>&1 && exit 0
    ((SECONDS - start > 20)) && exit 0
    echo "lumen-greeter: An4rch's login screen failed; trying ReGreet" >>"$log"
  fi
  start=$SECONDS
  cage -s -m last -- regreet "${args[@]}" >>"$log" 2>&1 && exit 0
  # It ran for a while, so it worked (and someone logged in): done.
  ((SECONDS - start > 20)) && exit 0
  echo "lumen-greeter: the graphical login screen failed; using the text one" >>"$log"
fi

exec tuigreet --time --time-format '%A %d %B  ·  %H:%M' --remember --asterisks \
  --greeting 'Welcome to An4rch' --cmd "$session"
