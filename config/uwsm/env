# Environment for the whole graphical session (read by uwsm before Hyprland
# starts, and exported to every app and service in the session).
export LUMEN_PATH="$HOME/.local/share/lumen"
export PATH="$LUMEN_PATH/bin:$HOME/.local/bin:$PATH"

export XCURSOR_THEME=Bibata-Modern-Classic
export XCURSOR_SIZE=24
export HYPRCURSOR_THEME=Bibata-Modern-Classic
export HYPRCURSOR_SIZE=24

export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=gtk3
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export SDL_VIDEODRIVER="wayland,x11"

export TERMINAL=anarch-term
export EDITOR=nvim
export VISUAL=nvim
