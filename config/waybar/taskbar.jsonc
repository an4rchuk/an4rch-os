// An4rch taskbar (bottom of the screen). Turn it on or off with:
//   An4rch menu → Toggle → Taskbar, or `anarch taskbar on|off`.
// Click an app to switch to it, click the active app to minimise it,
// middle-click to close. Minimised windows come back with a click.
{
  "layer": "top",
  "position": "bottom",
  "height": 44,
  "margin-bottom": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 4,
  "reload_style_on_change": true,

  "modules-left": ["custom/start", "wlr/taskbar"],
  "modules-center": [],
  "modules-right": ["custom/minimized", "clock#taskbar"],

  "custom/start": {
    "format": "󰣇",
    "tooltip-format": "Start",
    "on-click": "anarch-start",
    "on-click-right": "anarch-menu"
  },

  "wlr/taskbar": {
    "format": "{icon} {title:.24}",
    "icon-size": 20,
    "icon-theme": "Papirus-Dark",
    "tooltip-format": "{title}",
    "on-click": "minimize-raise",
    "on-click-middle": "close",
    "on-click-right": "fullscreen",
    "ignore-list": ["anarch-start"]
  },

  "custom/minimized": {
    "exec": "n=$(anarch-window list | wc -l); [ \"$n\" -gt 0 ] && echo \"󰖰 $n\" || echo",
    "interval": 2,
    "tooltip-format": "Minimised windows: click to restore one",
    "on-click": "anarch-window restore-menu"
  },

  "clock#taskbar": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A %d %B %Y}"
  }
}
