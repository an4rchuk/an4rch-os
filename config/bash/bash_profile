# ~/.bash_profile — login shell setup.
export LUMEN_PATH="${LUMEN_PATH:-$HOME/.local/share/lumen}"
export PATH="$LUMEN_PATH/bin:$HOME/.local/bin:$PATH"
export EDITOR=nvim VISUAL=nvim

# Without a display manager, logging in on the first console starts the
# desktop. (With greetd this never runs: it starts the session itself.)
if [[ -z "${WAYLAND_DISPLAY:-}" && "${XDG_VTNR:-}" == 1 ]] && command -v uwsm >/dev/null && uwsm check may-start >/dev/null 2>&1; then
  exec uwsm start -- hyprland.desktop
fi
# shellcheck source=/dev/null
[[ -f ~/.bashrc ]] && source ~/.bashrc
