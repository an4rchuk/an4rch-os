# An4rch terminal (Ghostty). Colours come from the active theme.
# Reference: https://ghostty.org/docs/config  ·  `ghostty +show-config --default --docs`

config-file = ?../lumen/current/theme/ghostty.conf

font-family = JetBrainsMono Nerd Font
font-size = 11.5
font-feature = calt
font-feature = liga
adjust-cell-height = 12%

window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
window-decoration = none
gtk-titlebar = false
gtk-single-instance = false
background-opacity = 0.96
unfocused-split-opacity = 0.85

cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false
shell-integration-features = cursor,sudo,title
resize-overlay = never
app-notifications = no-clipboard-copy,no-config-reload

keybind = ctrl+shift+enter=new_split:auto
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+left=previous_tab
keybind = ctrl+shift+right=next_tab
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
