#!/bin/bash
# lumen-hyprpm-seed ROOT USER — give USER the title bar plugin built with the ISO.
#
# iso/offline.sh builds hyprbars once (as "lumenbuild") for the Hyprland in
# the ISO's package repository. hyprpm keeps a build per user under
# /var/cache/hyprpm/<user>, so this unpacks it under USER's name in ROOT
# ("/" for the live system, /mnt for an install) and records the Hyprland
# version it was built for; `lumen-titlebars setup` then skips the build.
set -euo pipefail
root="${1:?usage: lumen-hyprpm-seed ROOT USER}" user="${2:?usage: lumen-hyprpm-seed ROOT USER}"
src=/opt/lumen-hyprpm
[[ -f "$src/hyprpm.tar" && -f "$src/hyprland-version" ]] || exit 1
dest="$root/var/cache/hyprpm/$user"
rm -rf "$dest"
install -d -m755 "$root/var/cache/hyprpm" "$dest"
tar -C "$dest" -xf "$src/hyprpm.tar"
# pkg-config files point at the build's own path; hyprpm needs them for later rebuilds.
grep -rlI "/var/cache/hyprpm/lumenbuild" "$dest" 2>/dev/null | xargs -r sed -i "s|/var/cache/hyprpm/lumenbuild|/var/cache/hyprpm/$user|g"
install -D -m644 "$src/hyprland-version" "$root/var/lib/lumen/hyprbars-hyprland"
