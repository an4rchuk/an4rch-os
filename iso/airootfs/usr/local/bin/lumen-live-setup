#!/bin/bash
# lumen-live-setup — prepare the live desktop on the Lumen OS USB (runs at boot).
#
# Creates the "live" user with Lumen's desktop, starts NetworkManager for the
# installer's Wi-Fi picker, and logs that user in on the first console, where
# Hyprland starts with the graphical installer open, Bazzite-style.
#
# Booting with lumen.text=1 ("text mode" in the boot menu) or lumen.auto=1
# (automated tests) skips all of this: root logs in and the text-mode
# installer runs, as before.
set -u
case " $(</proc/cmdline) " in
  *" lumen.auto=1 "* | *" lumen.text=1 "*) exit 0 ;;
esac

# Everything this does is logged for diagnosis (lumen-live-check prints it).
exec >>/var/log/lumen-live-setup.log 2>&1
echo "== $(date '+%T') lumen-live-setup"
set -x

user=live
home=/home/$user
lumen=/opt/lumen

id "$user" >/dev/null 2>&1 || useradd -m -G wheel,video,input,audio -s /usr/bin/zsh -c "Lumen live" "$user"
passwd -d "$user" >/dev/null
printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$user" >/etc/sudoers.d/90-lumen-live
chmod 440 /etc/sudoers.d/90-lumen-live

# The "(NVIDIA)" boot entry: NVIDIA's own driver instead of nouveau.
case " $(</proc/cmdline) " in
  *" lumen.nvidia=1 "*) modprobe nvidia_drm modeset=1 fbdev=1 || echo "NVIDIA driver didn't load (card older than GTX 16xx / RTX 20xx?)" ;;
esac

# Wi-Fi through NetworkManager (on top of iwd); wired stays with networkd.
# --no-block: this runs during boot, ordered before the login prompt;
# waiting here for other services could stall the boot.
systemctl start --no-block NetworkManager
# What the top bar talks to: Bluetooth, power profiles, battery.
systemctl start --no-block bluetooth power-profiles-daemon upower 2>/dev/null
# Sound (PipeWire) for every user session, as the installer sets it up.
systemctl --global enable pipewire.socket pipewire-pulse.socket wireplumber.service 2>/dev/null

# Title bars, if the ISO carries the plugin built for this Hyprland.
titlebars=no
if [[ -f /usr/lib/lumen/hyprbars.so &&
  "$(cat /var/lib/lumen/hyprbars-hyprland 2>/dev/null)" == "$(pacman -Q hyprland | awk '{print $2}')" ]]; then
  titlebars=yes
fi

# The user's desktop: the same files the Lumen installer writes.
# setpriv, not runuser: runuser opens a PAM login session, which waits for
# logins to be allowed, which waits for this boot step: a deadlock.
timeout 90 setpriv --reuid="$user" --regid="$user" --init-groups -- \
  env -i HOME="$home" USER="$user" LOGNAME="$user" PATH=/usr/local/bin:/usr/bin LUMEN_PATH="$lumen" TITLEBARS="$titlebars" \
  bash -s <<'SETUP'
set -u
mkdir -p ~/.config/lumen ~/.local/share/applications ~/.local/share/icons/hicolor/scalable/apps \
  ~/.local/share/backgrounds ~/.local/state/lumen ~/.config/autostart
ln -sfn "$LUMEN_PATH" ~/.local/share/lumen
cd "$LUMEN_PATH/config" && find . -type f | while read -r f; do
  rel="${f#./}"
  case "$rel" in
    zsh/zshrc) dest=~/.zshrc ;;
    zsh/zprofile) dest=~/.zprofile ;;
    *) dest=~/.config/$rel ;;
  esac
  mkdir -p "$(dirname "$dest")"
  cp "$f" "$dest"
done
cp "$LUMEN_PATH"/share/applications/*.desktop ~/.local/share/applications/
cp "$LUMEN_PATH"/share/icons/hicolor/scalable/apps/*.svg ~/.local/share/icons/hicolor/scalable/apps/
cat >~/.config/lumen/settings.conf <<CONF
LUMEN_TERMINAL=ghostty
LUMEN_BROWSER=firefox
LUMEN_EDITOR=nvim
LUMEN_FILES=nautilus
LUMEN_TITLEBARS=$TITLEBARS
LUMEN_TASKBAR=yes
LUMEN_IDLE_SUSPEND=never
CONF
[[ -d /opt/lumen-wallpapers ]] && ln -sfn /opt/lumen-wallpapers ~/.local/share/backgrounds/lumen
"$LUMEN_PATH/bin/lumen-theme" set lumen >/dev/null 2>&1
"$LUMEN_PATH/bin/lumen-session" autostart
touch ~/.local/state/lumen/welcome-done
printf '["lumen-installer.desktop", "lumen-welcome.desktop", "lumen-settings.desktop", "com.mitchellh.ghostty.desktop", "lumen-store.desktop"]\n' >~/.config/lumen/start-pins.json
cp /usr/share/applications/lumen-installer.desktop ~/.config/autostart/
# Start the desktop on the first console. Unlike an installed system's
# ~/.zprofile this doesn't depend on uwsm's may-start check, and if the
# desktop can't start (or stops) on this hardware, the text installer
# takes over instead of leaving a bare prompt. It runs silently, so the
# console never shows: the boot goes straight from the menu to the desktop.
touch ~/.hushlogin
cat >~/.zprofile <<'PROFILE'
export LUMEN_PATH="${LUMEN_PATH:-$HOME/.local/share/lumen}"
export PATH="$LUMEN_PATH/bin:$HOME/.local/bin:$PATH"
export EDITOR=nvim VISUAL=nvim
if [[ "$(tty)" == /dev/tty1 && -z "${WAYLAND_DISPLAY:-}" && -z "${LUMEN_LIVE_TRIED:-}" ]]; then
  export LUMEN_LIVE_TRIED=1
  mkdir -p ~/.local/state/lumen
  log=~/.local/state/lumen/live-session.log
  clear
  printf '\e[?25l' # no blinking cursor while the desktop starts
  # The desktop needs a working graphics driver (a render node); without
  # one it hangs instead of failing. On real hardware autologin can beat
  # the GPU driver (e.g. amdgpu on an HP with Ryzen graphics), so wait for it.
  udevadm settle --timeout=20 2>/dev/null
  for _ in $(seq 40); do ls /dev/dri 2>/dev/null | grep -q '^renderD' && break; sleep 0.5; done
  sleep 1
  { echo "graphics:"; lspci -nnk 2>/dev/null | grep -A3 -iE 'vga|3d|display'; ls -l /dev/dri 2>&1; } >"$log"
  if ls /dev/dri 2>/dev/null | grep -q '^renderD'; then
    # Watchdog: if Hyprland hasn't come up in 45 s (a driver that hangs), stop trying.
    ( sleep 45; ls "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" 2>/dev/null | grep -q . ||
      { echo "desktop didn't come up in 45 s: stopping it" >>"$log"; pkill -u "$USER" -f 'uwsm start'; pkill -u "$USER" -x Hyprland; } ) &!
    watchdog=$!
    uwsm start -- hyprland.desktop >>"$log" 2>&1
    kill "$watchdog" 2>/dev/null
  else
    echo "no render node: not starting the desktop" >>"$log"
  fi
  clear
  printf '\e[?25h'
  echo
  echo "  The Lumen live desktop stopped or couldn't start on this computer."
  echo "  A photo of this screen helps fix it:"
  echo
  lspci -nn 2>/dev/null | grep -iE 'vga|3d|display' | sed 's/^/    /' | cut -c1-110
  echo "    boot mode: $([[ -d /sys/firmware/efi ]] && echo UEFI || echo legacy BIOS) · driver: $(lspci -k 2>/dev/null | grep -A3 -iE 'vga|3d' | sed -n 's/.*Kernel driver in use: //p' | tr '\n' ' ')"
  if lspci -nn 2>/dev/null | grep -iE 'vga|3d' | grep -q '\[10de:' && ! grep -q 'lumen.nvidia=1' /proc/cmdline; then
    echo
    echo "  This computer has NVIDIA graphics: restart and choose \"Lumen OS installer (NVIDIA)\""
    echo "  in the boot menu (GTX 16xx / RTX 20xx and newer)."
  fi
  hlog=$(ls -t "${XDG_RUNTIME_DIR:-/run/user/$UID}"/hypr/*/hyprland.log 2>/dev/null | head -n1)
  { [[ -n "$hlog" ]] && grep -iE 'err|fail|crit' "$hlog" | tail -n 6; tail -n 4 "$log"; } 2>/dev/null | cut -c1-110 | sed 's/^/    /'
  echo
  echo "  Press Enter for the text installer (it works the same way)."
  echo "  To try the desktop again instead: uwsm start -- hyprland.desktop"
  read -r -t 120 _ || true
  sudo lumen-os-install
fi
PROFILE
SETUP

# Log the live user in on tty1 instead of root's text installer.
mkdir -p /run/systemd/system/getty@tty1.service.d
cat >/run/systemd/system/getty@tty1.service.d/zz-lumen-live.conf <<EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty -o '-p -f -- \\\\u' --noclear --noissue --nohints --autologin $user - \$TERM
EOF
systemctl daemon-reload

# Read the apps people open first into memory, in the background, so they
# start quickly instead of loading from the stick.
systemd-run --on-active=40 --unit=lumen-live-preload -p Nice=19 -p IOSchedulingClass=idle \
  /usr/local/bin/lumen-live-preload

# VM test (lumen.livecheck=1): report on the live desktop once it's up.
case " $(</proc/cmdline) " in
  *" lumen.livecheck=1 "*) systemd-run --on-active=100 --unit=lumen-live-check /usr/local/bin/lumen-live-check ;;
esac
