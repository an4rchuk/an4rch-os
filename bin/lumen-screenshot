#!/usr/bin/env bash
# lumen-screenshot — obsolete name (before An4rch OS 1.1.0) of anarch-screenshot; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-screenshot is obsolete: use anarch-screenshot (or: anarch screenshot)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-screenshot" "$@"
