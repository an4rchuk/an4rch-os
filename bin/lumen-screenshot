#!/usr/bin/env bash
# lumen-screenshot — capture a region, window or screen (Print / SUPER + SHIFT + X).
#
#   lumen-screenshot region | window | screen | edit
#
# The image is copied to the clipboard and saved to ~/Pictures/Screenshots.
# Click the notification to annotate it.
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

mode="${1:-region}"
mkdir -p "$LUMEN_SCREENSHOT_DIR"
file="$LUMEN_SCREENSHOT_DIR/Screenshot-$(date +%Y-%m-%d_%H-%M-%S).png"

pkill -x slurp 2>/dev/null && exit 0 # pressing the key again cancels

case "$mode" in
  region | edit)
    # Offer the visible windows as snap targets as well as free selection.
    geometry=$(hyprctl clients -j | jq -r --argjson ws "$(hyprctl monitors -j | jq '[.[].activeWorkspace.id]')" \
      '.[] | select(.workspace.id as $w | $ws | index($w)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"' |
      slurp -d -b '#00000055' -c '#ffffffcc' -w 2 2>/dev/null) || exit 0
    grim -g "$geometry" "$file"
    ;;
  window)
    geometry=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
    [[ "$geometry" == *null* ]] && die "No active window"
    grim -g "$geometry" "$file"
    ;;
  screen)
    output=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')
    grim -o "$output" "$file"
    ;;
  *) die "usage: lumen-screenshot region|window|screen|edit" ;;
esac

wl-copy --type image/png <"$file"

if [[ "$mode" == edit ]]; then
  launch satty --filename "$file"
  exit 0
fi

# Notification with an "Annotate" action; runs in the background so the
# hotkey returns immediately.
(
  action=$(notify-send -a an4rch -i "$file" -A "edit=Annotate" -A "open=Show in folder" \
    "Screenshot copied" "Saved to ${file/#$HOME/\~}" 2>/dev/null || true)
  case "$action" in
    edit) launch satty --filename "$file" ;;
    open) launch xdg-open "$LUMEN_SCREENSHOT_DIR" ;;
  esac
) >/dev/null 2>&1 &
disown
