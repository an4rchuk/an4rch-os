#!/usr/bin/env bash
# anarch-titlebars — title bars with close, maximise and minimise buttons on every window.
#
#   anarch-titlebars on       turn them on (builds the plugin if needed, a minute or two)
#   anarch-titlebars off      turn them off: a clean, borderless tiling look
#   anarch-titlebars toggle   switch between the two
#   anarch-titlebars status   show whether they're on and the plugin is loaded
#   anarch-titlebars setup    build the plugin if Hyprland changed (--force: always)
#   anarch-titlebars load     load the plugin into the running session (used at login)
#
# The bars come from hyprbars, Hyprland's official plugin, compiled for your
# exact Hyprland version (an4rch OS ships it prebuilt) into
# /usr/lib/lumen/hyprbars.so. Their colours follow your theme.
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"
source "$LUMEN_PATH/install/packages.sh"

SO=/usr/lib/lumen/hyprbars.so
# The Hyprland version the plugin was built for: a plugin only loads into
# the Hyprland it was compiled against.
STAMP=/var/lib/lumen/hyprbars-hyprland

in_session() { [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; }
hyprland_version() { pacman -Q hyprland 2>/dev/null | awk '{print $2}'; }
built() { [[ -f "$SO" ]]; }
up_to_date() { built && [[ -f "$STAMP" && "$(cat "$STAMP")" == "$(hyprland_version)" ]]; }
loaded() { hyprctl plugin list 2>/dev/null | grep -q hyprbars; }

setup() {
  if [[ "${1:-}" != --force ]] && up_to_date; then
    echo "The title bar plugin is already built for Hyprland $(hyprland_version)."
    return 0
  fi
  local missing=() p tmp
  for p in "${PKGS_TITLEBARS[@]}"; do pacman -Q "$p" >/dev/null 2>&1 || missing+=("$p"); done
  if ((${#missing[@]})); then
    echo "Installing build tools: ${missing[*]}"
    sudo pacman -S --needed --noconfirm "${missing[@]}"
  fi
  echo "Building the title bar plugin for Hyprland $(hyprland_version)…"
  tmp=$(mktemp -d)
  "$LUMEN_PATH/bin/anarch-hyprbars-build" "$tmp/hyprbars.so"
  sudo install -D -m755 "$tmp/hyprbars.so" "$SO"
  hyprland_version | sudo install -D -m644 /dev/stdin "$STAMP"
  rm -rf "$tmp"
}

set_setting() {
  mkdir -p "$LUMEN_CONFIG"
  local f="$LUMEN_CONFIG/settings.conf"
  touch "$f"
  if grep -q '^LUMEN_TITLEBARS=' "$f"; then
    sed -i "s/^LUMEN_TITLEBARS=.*/LUMEN_TITLEBARS=$1/" "$f"
  else
    printf '\n# Title bars with window buttons: yes | no\nLUMEN_TITLEBARS=%s\n' "$1" >>"$f"
  fi
}

load() {
  [[ "${LUMEN_TITLEBARS:-yes}" == yes ]] || return 0
  in_session || return 0
  mkdir -p "$LUMEN_STATE"
  {
    date
    if ! up_to_date; then
      echo "not loading: plugin built for '$(cat "$STAMP" 2>/dev/null)', Hyprland is '$(hyprland_version)' (run: anarch titlebars setup)"
    elif loaded; then
      echo "already loaded"
    else
      hyprctl plugin load "$SO"
    fi
  } >"$LUMEN_STATE/titlebars.log" 2>&1 || true
}

on() {
  set_setting yes
  up_to_date || setup
  LUMEN_TITLEBARS=yes load
  notify "Title bars on" "Close, maximise and minimise buttons on every window" -i window-new
}

off() {
  set_setting no
  if in_session && loaded; then hyprctl plugin unload "$SO" >/dev/null 2>&1 || true; fi
  notify "Title bars off" "Windows tile edge to edge" -i window-new
}

status() {
  echo "Setting:  LUMEN_TITLEBARS=${LUMEN_TITLEBARS:-yes}"
  if up_to_date; then
    echo "Plugin:   built for Hyprland $(cat "$STAMP")"
  elif built; then
    echo "Plugin:   built for Hyprland $(cat "$STAMP" 2>/dev/null || echo '?'), but $(hyprland_version) is installed (anarch titlebars setup)"
  else
    echo "Plugin:   not built (anarch titlebars setup)"
  fi
  if in_session && loaded; then echo "Session:  loaded"; else echo "Session:  not loaded"; fi
}

# Building takes a minute or two: from a key binding or menu, show it in a terminal.
case "${1:-toggle}" in
  on | setup | toggle)
    if [[ ! -t 0 && -z "${LUMEN_YES:-}" ]] && in_session && ! up_to_date; then
      term --float --hold --title "Title bars" -- "$0" "$@"
      exit 0
    fi
    ;;
esac

case "${1:-toggle}" in
  on) on ;;
  off) off ;;
  toggle) if [[ "${LUMEN_TITLEBARS:-yes}" == yes ]] && in_session && loaded; then off; else on; fi ;;
  status) status ;;
  setup) setup "${2:-}" ;;
  load) load ;;
  -h | --help | help) sed -n '2,13s/^# \{0,1\}//p' "$0" ;;
  *) die "Unknown command '$1'. See: anarch-titlebars --help" ;;
esac
