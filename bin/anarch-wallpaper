#!/usr/bin/env bash
# anarch-wallpaper — change the desktop background.
#
#   anarch-wallpaper next | prev    cycle through this theme's wallpapers
#   anarch-wallpaper pick           choose from a menu
#   anarch-wallpaper set FILE       use any image
#   anarch-wallpaper list           print this theme's wallpapers
#   anarch-wallpaper generate       (re)create An4rch's wallpapers for every theme
#   anarch-wallpaper restore        re-apply the current wallpaper (used at login)
#
# Your own images go in ~/Pictures/Wallpapers (all themes) or
# ~/.config/lumen/backgrounds/<theme>/ (one theme).
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

theme=$(theme_current)
link="$LUMEN_CURRENT/wallpaper"
remember="$LUMEN_STATE/wallpaper-$theme"

list() {
  local d tdir
  tdir=$(theme_dir "$theme" || true)
  for d in "$LUMEN_CONFIG/backgrounds/$theme" "${tdir:+$tdir/backgrounds}" "$LUMEN_WALLPAPERS/$theme" "$HOME/Pictures/Wallpapers"; do
    [[ -n "$d" && -d "$d" ]] || continue
    find -L "$d" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) | sort
  done
}

# Show the image now. A new swaybg starts before the old one quits, so the
# change is seamless.
show() {
  local old
  old=$(pgrep -x swaybg || true)
  if [[ -e "$link" ]]; then
    launch swaybg -i "$link" -m fill
  else
    local bg
    bg=$(theme_get "$theme" bg || echo '#0b0b0b')
    launch swaybg -c "$bg"
  fi
  if [[ -n "$old" ]]; then
    sleep 0.6
    # shellcheck disable=SC2086
    kill $old 2>/dev/null || true
  fi
}

use() {
  local file
  file=$(realpath "$1")
  [[ -f "$file" ]] || die "No such image: $1"
  mkdir -p "$LUMEN_CURRENT" "$LUMEN_STATE"
  ln -sfn "$file" "$link"
  printf '%s\n' "$file" >"$remember"
  show
  "$LUMEN_PATH/bin/anarch-login" sync >/dev/null 2>&1 || true
}

step() {
  mapfile -t all < <(list)
  [[ ${#all[@]} -gt 0 ]] || { notify "No wallpapers yet" "Run: anarch-wallpaper generate"; exit 1; }
  local cur i
  cur=$(readlink "$link" 2>/dev/null || true)
  for i in "${!all[@]}"; do
    if [[ "${all[$i]}" == "$cur" ]]; then
      use "${all[$(((i + $1 + ${#all[@]}) % ${#all[@]}))]}"
      return
    fi
  done
  use "${all[0]}"
}

case "${1:-next}" in
  next) step 1 ;;
  prev) step -1 ;;
  list) list ;;
  set) use "${2:?usage: anarch-wallpaper set FILE}" ;;
  pick)
    mapfile -t all < <(list)
    [[ ${#all[@]} -gt 0 ]] || { notify "No wallpapers yet" "Run: anarch-wallpaper generate"; exit 1; }
    choice=$(for f in "${all[@]}"; do printf '%s\0icon\x1f%s\n' "$(basename "$f")" "$f"; done |
      menu "Wallpaper" --index --lines 8) || exit 0
    use "${all[$choice]}"
    ;;
  theme)
    # Called by anarch-theme: reuse what was picked for this theme last time.
    if [[ -f "$remember" && -f "$(cat "$remember")" ]]; then
      use "$(cat "$remember")"
    else
      # Wallpapers are painted the first time a theme is used.
      if ! compgen -G "$LUMEN_WALLPAPERS/$theme/[0-9][0-9]-*.jpg" >/dev/null && has python3 && python3 -c 'import PIL' 2>/dev/null; then
        size=3840x2160
        if has hyprctl && has jq; then
          s=$(hyprctl monitors -j 2>/dev/null | jq -r 'max_by(.width * .height) | "\(.width)x\(.height)"' 2>/dev/null || true)
          [[ "$s" =~ ^[0-9]{3,5}x[0-9]{3,5}$ ]] && size=$s
        fi
        python3 "$LUMEN_PATH/bin/anarch-wallgen" --theme "$theme" --size "$size" --out "$LUMEN_WALLPAPERS" >/dev/null 2>&1 || true
      fi
      first=$(list | head -n1)
      if [[ -n "$first" ]]; then use "$first"; else rm -f "$link"; show; fi
    fi
    ;;
  restore)
    if [[ ! -e "$link" ]]; then
      "$0" theme
    else
      show
    fi
    ;;
  generate)
    has python3 || die "python3 is needed to generate wallpapers"
    notify "Generating wallpapers" "This takes a few seconds…" -t 3000
    python3 "$LUMEN_PATH/bin/anarch-wallgen" --all --out "$LUMEN_WALLPAPERS"
    "$0" theme
    ;;
  -h | --help | help) sed -n '2,13s/^# \{0,1\}//p' "$0" ;;
  *) die "Unknown command '$1'. See: anarch-wallpaper --help" ;;
esac
