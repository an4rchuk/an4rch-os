#!/usr/bin/env bash
# lumen-status — obsolete name (before An4rch OS 1.1.0) of anarch-status; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-status is obsolete: use anarch-status (or: anarch status)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-status" "$@"
