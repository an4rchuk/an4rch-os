#!/usr/bin/env bash
# lumen-desktop — obsolete name (before An4rch OS 1.1.0) of anarch-desktop; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-desktop is obsolete: use anarch-desktop (or: anarch desktop)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-desktop" "$@"
