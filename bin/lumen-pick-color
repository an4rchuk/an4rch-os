#!/usr/bin/env bash
# lumen-pick-color — obsolete name (before an4rch OS 1.1.0) of anarch-pick-color; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-pick-color is obsolete: use anarch-pick-color (or: anarch pick-color)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-pick-color" "$@"
