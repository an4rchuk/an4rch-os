#!/usr/bin/env bash
# lumen-launch — obsolete name (before An4rch OS 1.1.0) of anarch-launch; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-launch is obsolete: use anarch-launch (or: anarch launch)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-launch" "$@"
