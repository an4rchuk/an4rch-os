#!/usr/bin/env bash
# lumen-welcome — obsolete name (before An4rch OS 1.1.0) of anarch-welcome; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-welcome is obsolete: use anarch-welcome (or: anarch welcome)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-welcome" "$@"
