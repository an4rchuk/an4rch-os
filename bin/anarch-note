#!/usr/bin/env bash
# anarch-note — quick notes that drop down over everything (SUPER + ALT + K), like Sticky Notes.
#
#   anarch-note            show or hide the notes window
#   anarch-note TEXT...    add a line to your notes without opening them
#   anarch-note path       where the notes are kept
#
# Notes are plain Markdown in ~/Notes/notes.md (LUMEN_NOTES to change) and
# save as you type.
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

file="${LUMEN_NOTES:-$HOME/Notes/notes.md}"
mkdir -p "$(dirname "$file")"
[[ -f "$file" ]] || printf '# Notes\n\n' >"$file"

case "${1:-}" in
  path) echo "$file"; exit 0 ;;
  -h | --help | help) sed -n '2,9s/^# \{0,1\}//p' "$0"; exit 0 ;;
  "") ;;
  *)
    printf -- '- %s  _(%s)_\n' "$*" "$(date '+%d %b %H:%M')" >>"$file"
    echo "✓ Noted"
    exit 0
    ;;
esac

open_now() { hyprctl clients -j 2>/dev/null | jq -e '.[] | select(.class == "lumen.notes")' >/dev/null 2>&1; }
shown() { hyprctl monitors -j 2>/dev/null | jq -e '.[] | select(.focused) | .specialWorkspace.name == "special:notes"' >/dev/null 2>&1; }
toggle() { hyprctl dispatch 'hl.dsp.workspace.toggle_special("notes")' >/dev/null 2>&1; }

if open_now; then
  toggle
  exit 0
fi

# Saves a second after you stop typing, and whenever the window loses focus.
if has nvim; then
  editor=(nvim -c 'set updatetime=1000 wrap linebreak spell' -c 'autocmd CursorHold,CursorHoldI,FocusLost,BufLeave * silent! update' -c 'normal! G' "$file")
else
  editor=(nano --saveonexit "$file")
fi
term --class lumen.notes --title "Notes" -- "${editor[@]}"
for _ in $(seq 25); do
  open_now && break
  sleep 0.2
done
shown || toggle
