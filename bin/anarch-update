#!/usr/bin/env bash
# anarch-update — update An4rch, system packages, Flatpaks and firmware (SUPER + ALT + U).
#
#   anarch-update           everything
#   anarch-update lumen     only An4rch itself
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

if [[ ! -t 0 ]]; then
  term --float --title "Update" -- "$0" "$@"
  exit 0
fi

step() { printf '\n\e[1;35m󰚰  %s\e[0m\n\n' "$*"; }

update_lumen() {
  step "an4rch"
  if [[ ! -d "$LUMEN_PATH/.git" ]]; then
    echo "  $LUMEN_PATH is not a git checkout; skipping."
    return 0
  fi
  local g=(git -C "$LUMEN_PATH") repo fetched=0
  local before latest target
  # Older installs point at an address that no longer exists (GitHub then
  # asks for a login); never prompt, just fail with a message.
  export GIT_TERMINAL_PROMPT=0
  "${g[@]}" config core.fileMode false
  # ISOs up to 1.1.1 carried the build machine's GitHub login (expired since),
  # which GitHub refuses: drop it. Also trust this checkout if it changed owner.
  "${g[@]}" config --local --unset-all http.https://github.com/.extraheader 2>/dev/null || true
  "${g[@]}" config --local --remove-section credential 2>/dev/null || true
  if ! "${g[@]}" status --porcelain >/dev/null 2>&1; then
    git config --global --add safe.directory "$LUMEN_PATH" 2>/dev/null || true
  fi
  local err
  err=$(mktemp)
  # The project's home, then its name before the An4rch rename (GitHub
  # forwards that one once the repository is renamed).
  for repo in ${LUMEN_REPO:-https://github.com/an4rchuk/an4rch-os.git https://github.com/an4rchuk/lumen-os.git}; do
    if [[ "$("${g[@]}" remote get-url origin 2>/dev/null)" != "$repo" ]]; then
      "${g[@]}" remote set-url origin "$repo" 2>/dev/null || "${g[@]}" remote add origin "$repo"
    fi
    if "${g[@]}" fetch --quiet --force --tags origin 2>"$err"; then
      fetched=1
      break
    fi
  done
  if ((!fetched)); then
    # Say what actually went wrong: no internet, or GitHub refusing.
    if curl -fsI --max-time 10 https://github.com >/dev/null 2>&1; then
      echo "  GitHub is reachable, but downloading An4rch's update failed; An4rch stays as it is:"
      sed 's/^/    /' "$err" | tail -n 4
      echo "  (Please report this: anarch report.)"
    else
      echo "  Couldn't reach GitHub (no internet?); An4rch stays as it is."
    fi
    rm -f "$err"
    return 0
  fi
  rm -f "$err"
  # Updates follow the releases (v1.0.8, v1.0.9, …), the same code as the ISOs.
  latest=$("${g[@]}" tag -l 'v[0-9]*' --sort=-v:refname | head -n1)
  before=$("${g[@]}" rev-parse HEAD)
  target=$("${g[@]}" rev-parse "${latest:-HEAD}^{commit}" 2>/dev/null || echo "$before")
  if [[ -z "$latest" || "$target" == "$before" ]] || "${g[@]}" merge-base --is-ancestor "$target" "$before" 2>/dev/null; then
    echo "  Already up to date ($("${g[@]}" describe --tags --always 2>/dev/null))."
    return 0
  fi
  # Edits to An4rch's own files are kept in a stash (git stash list), not lost.
  "${g[@]}" stash push --quiet -m "anarch update $(date '+%F %T')" 2>/dev/null || true
  if ! "${g[@]}" checkout --quiet --detach "$latest" 2>/dev/null; then
    "${g[@]}" checkout --quiet --force --detach "$latest"
  fi
  echo "  Updated to $latest:"
  "${g[@]}" log --oneline --no-decorate "$before..$target" 2>/dev/null | head -n 30 | sed 's/^/  /'
  bash "$LUMEN_PATH/install/migrate.sh"
  is_server || "$LUMEN_PATH/bin/anarch-theme" render >/dev/null || true
}

update_system() {
  step "System packages"
  if has yay; then
    yay -Syu
  elif has paru; then
    paru -Syu
  else
    sudo pacman -Syu
  fi

  # A new Hyprland needs the title bar plugin rebuilt for it.
  if [[ "${LUMEN_TITLEBARS:-yes}" == yes && -f /usr/lib/lumen/hyprbars.so ]]; then
    step "Window title bars"
    LUMEN_YES=1 "$LUMEN_PATH/bin/anarch-titlebars" setup </dev/null || echo "  Title bars could not be rebuilt; run: anarch titlebars setup --force"
  fi

  if has flatpak && [[ -n "$(flatpak list --app --columns=application 2>/dev/null)" ]]; then
    step "Flatpak apps"
    flatpak update -y
  fi

  if has fwupdmgr; then
    step "Firmware"
    fwupdmgr refresh --force >/dev/null 2>&1 || true
    if fwupdmgr get-updates >/dev/null 2>&1; then
      fwupdmgr get-updates || true
      read -rp "Install firmware updates now? [y/N] " yn
      [[ "$yn" == [yY]* ]] && fwupdmgr update
    else
      echo "  No firmware updates."
    fi
  fi

  # Pacman keeps new versions of edited config files as .pacnew.
  if has pacdiff && find /etc -name '*.pacnew' 2>/dev/null | grep -q .; then
    step "Config files to review"
    find /etc -name '*.pacnew' 2>/dev/null | sed 's/^/  /'
    echo "  Review them with: sudo pacdiff"
  fi
}

case "${1:-all}" in
  lumen) update_lumen ;;
  all) update_lumen; update_system ;;
  *) die "usage: anarch-update [all|lumen]" ;;
esac

bar_signal updates
# After a kernel upgrade the running kernel's modules are only kept until a
# restart (install/keep-modules.sh), or gone: time to restart.
if [[ ! -d "/usr/lib/modules/$(uname -r)" || -e "/usr/lib/modules/$(uname -r)/.lumen-kept" ]]; then
  printf '\n\e[33m󰜉  A new kernel was installed — restart when convenient.\e[0m\n'
fi
printf '\n\e[1;32m✓ All done.\e[0m\n'
printf '\e[2mPress any key to close…\e[0m'
read -rsn1
