#!/usr/bin/env bash
# lumen-osd — volume and brightness keys with an on-screen indicator.
#
#   lumen-osd volume up|down|up-fine|down-fine|mute
#   lumen-osd mic mute
#   lumen-osd brightness up|down
#   lumen-osd keyboard up|down|cycle
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

show() { # show TITLE PERCENT ICON
  notify-send -a an4rch -c osd -u low -t 1400 -i "$3" \
    -h string:x-canonical-private-synchronous:lumen-osd -h "int:value:$2" "$1" "" 2>/dev/null || true
}

volume() {
  local v
  v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
  if [[ "$v" == *MUTED* ]]; then
    show "Muted" 0 audio-volume-muted
  else
    v=$(awk '{printf "%d", $2 * 100 + 0.5}' <<<"$v")
    local icon=audio-volume-high
    ((v < 66)) && icon=audio-volume-medium
    ((v < 33)) && icon=audio-volume-low
    show "Volume  $v%" "$v" "$icon"
  fi
}

case "${1:-} ${2:-}" in
  "volume up") wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+; volume ;;
  "volume down") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; volume ;;
  "volume up-fine") wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 1%+; volume ;;
  "volume down-fine") wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-; volume ;;
  "volume mute") wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; volume ;;
  "mic mute")
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
      show "Microphone off" 0 microphone-sensitivity-muted
    else
      show "Microphone on" 100 audio-input-microphone
    fi
    ;;
  "brightness up" | "brightness down")
    [[ "$2" == up ]] && step="5%+" || step="5%-"
    brightnessctl -e4 -n2 -q set "$step"
    pct=$(brightnessctl -m | cut -d, -f4 | tr -d %)
    show "Brightness  $pct%" "$pct" display-brightness
    ;;
  "keyboard up" | "keyboard down" | "keyboard cycle")
    dev=$(brightnessctl -l -m -c leds | grep -m1 kbd_backlight | cut -d, -f1) || exit 0
    [[ -n "$dev" ]] || exit 0
    case "$2" in
      up) step="1+" ;;
      down) step="1-" ;;
      # One key that steps through the levels and back to off (ASUS's F4).
      *) cur=$(brightnessctl -m -d "$dev" | cut -d, -f3); max=$(brightnessctl -m -d "$dev" | cut -d, -f5)
        if ((cur >= max)); then step=0; else step="1+"; fi ;;
    esac
    brightnessctl -q -d "$dev" set "$step"
    pct=$(brightnessctl -m -d "$dev" | cut -d, -f4 | tr -d %)
    show "Keyboard light  $pct%" "$pct" keyboard-brightness
    ;;
  *) sed -n '2,7s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
