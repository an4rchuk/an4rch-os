#!/usr/bin/env bash
# lumen-pkg — find, install and remove software (SUPER + ALT + I).
#
#   lumen-pkg install        search official repos + AUR, pick with Tab, Enter
#   lumen-pkg remove         pick installed packages to remove
#   lumen-pkg popular        hand-picked apps (browsers, chat, media, office, …)
#   lumen-pkg flatpak        search Flathub
#   lumen-pkg bundle NAME    install a bundle: dev, gaming, office, creative
#   lumen-pkg add PKG...     install by name (repos first, then AUR)
#   lumen-pkg rm PKG...      remove by name
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

# Interactive commands need a terminal: when started from a key binding or
# menu, re-open inside a floating one.
if [[ ! -t 0 && "${1:-}" != add && "${1:-}" != rm ]]; then
  term --float --title "Software" -- "$0" "$@"
  exit 0
fi

aur() { has yay && echo yay || { has paru && echo paru; } || true; }

header() { printf '\n\e[1;35m%s\e[0m  \e[2m%s\e[0m\n\n' "$1" "${2:-}"; }

pause() { printf '\n\e[2mPress any key to close…\e[0m'; read -rsn1; }

# add PKG... — official repos when possible, AUR otherwise.
add() {
  local repo=() aurpkgs=() p helper
  for p in "$@"; do
    if pacman -Si "$p" >/dev/null 2>&1; then repo+=("$p"); else aurpkgs+=("$p"); fi
  done
  [[ ${#repo[@]} -gt 0 ]] && sudo pacman -S --needed "${repo[@]}"
  if [[ ${#aurpkgs[@]} -gt 0 ]]; then
    helper=$(aur)
    [[ -n "$helper" ]] || die "Not in the official repos and no AUR helper found: ${aurpkgs[*]}"
    "$helper" -S --needed "${aurpkgs[@]}"
  fi
  update-desktop-database -q ~/.local/share/applications 2>/dev/null || true
}

install() {
  header "Install software" "type to search · Tab to select several · Enter to install · Esc to quit"
  local helper preview
  helper=$(aur)
  if [[ -n "$helper" ]]; then
    list() { "$helper" -Slq; }
    preview="$helper -Si {1}"
  else
    list() { pacman -Slq; }
    preview="pacman -Si {1}"
  fi
  mapfile -t picks < <(list | sort -u | fzf --multi --height=100% --preview "$preview" \
    --preview-window 'right,58%,wrap' --prompt 'Install ❯ ' --header 'Official repositories and AUR')
  [[ ${#picks[@]} -gt 0 ]] || return 0
  add "${picks[@]}"
  notify "Installed" "${picks[*]}" -i system-software-install
  pause
}

remove() {
  header "Remove software" "Tab to select several · Enter to remove"
  mapfile -t picks < <(pacman -Qeq | fzf --multi --height=100% --preview 'pacman -Qi {1}' \
    --preview-window 'right,58%,wrap' --prompt 'Remove ❯ ')
  [[ ${#picks[@]} -gt 0 ]] || return 0
  sudo pacman -Rns "${picks[@]}"
  notify "Removed" "${picks[*]}" -i edit-delete
  pause
}

# Curated catalogue: label<TAB>description<TAB>packages (flatpak:ID for Flathub).
popular_list() {
  cat <<'EOF'
Chromium	Fast, Wayland-native web browser	chromium
Brave	Privacy-first Chromium browser	brave-bin
Zen Browser	Firefox-based, calm and tidy	zen-browser-bin
Google Chrome	Google's browser	google-chrome
Thunderbird	Email and calendar	thunderbird
Signal	Private messaging	signal-desktop
Telegram	Messaging	telegram-desktop
Discord	Chat for communities	discord
Slack	Team chat	slack-desktop
Zoom	Video calls	zoom
Spotify	Music streaming	spotify
mpv	Plays every video file	mpv
VLC	Media player	vlc
OBS Studio	Streaming and screen recording	obs-studio
Kdenlive	Video editor	kdenlive
GIMP	Photo editing	gimp
Inkscape	Vector graphics	inkscape
Krita	Painting	krita
Blender	3D creation	blender
LibreOffice	Office suite	libreoffice-fresh
OnlyOffice	Office suite, MS Office look	onlyoffice-bin
Obsidian	Notes and knowledge base	obsidian
Logseq	Outliner notes	logseq-desktop-bin
Bitwarden	Password manager	bitwarden
1Password	Password manager	1password
KeePassXC	Offline password manager	keepassxc
Zed	Fast code editor	zed
Visual Studio Code (Microsoft)	The official VS Code build	visual-studio-code-bin
Cursor	AI code editor	cursor-bin
Neovim	Terminal editor	neovim
Docker	Containers	docker docker-compose docker-buildx
Podman Desktop	Containers, rootless	podman-desktop
Steam	Games	steam
Heroic	Epic and GOG games	heroic-games-launcher-bin
Localsend	AirDrop-style file sharing	localsend-bin
Syncthing	Sync folders between devices	syncthing
Nextcloud	Cloud sync client	nextcloud-client
Transmission	Torrents	transmission-gtk
Calibre	E-books	calibre
Xournal++	Handwritten notes and PDF annotation	xournalpp
EOF
}

popular() {
  header "Popular apps" "Tab to select several · Enter to install"
  mapfile -t picks < <(popular_list | fzf --multi --height=100% --delimiter '\t' --with-nth 1,2 \
    --tabstop 32 --prompt 'Install ❯ ' --preview 'echo {3}' --preview-window 'down,1,border-top')
  [[ ${#picks[@]} -gt 0 ]] || return 0
  local pkgs=() line
  for line in "${picks[@]}"; do
    read -ra p <<<"$(cut -f3 <<<"$line")"
    pkgs+=("${p[@]}")
  done
  add "${pkgs[@]}"
  [[ " ${pkgs[*]} " == *" docker "* ]] && { sudo systemctl enable --now docker.socket; sudo usermod -aG docker "$USER"; echo "Log out and back in to use docker without sudo."; }
  notify "Installed" "${pkgs[*]}" -i system-software-install
  pause
}

flatpak_search() {
  has flatpak || { add flatpak; flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo; }
  header "Flathub" "Tab to select several · Enter to install"
  mapfile -t picks < <(flatpak remote-ls --app --columns=application,name,description flathub 2>/dev/null |
    fzf --multi --height=100% --delimiter '\t' --with-nth 2,3 --prompt 'Flathub ❯ ' \
      --preview 'flatpak remote-info flathub {1} 2>/dev/null' --preview-window 'right,50%,wrap' | cut -f1)
  [[ ${#picks[@]} -gt 0 ]] || return 0
  flatpak install -y flathub "${picks[@]}"
  notify "Installed" "${picks[*]}" -i system-software-install
  pause
}

bundle() {
  local name="${1:-}" pkgs=()
  case "$name" in
    dev) pkgs=(git github-cli lazygit mise docker docker-compose docker-buildx python python-pip nodejs npm go rust jq yq httpie sqlite postgresql-libs) ;;
    gaming) pkgs=(steam gamemode lib32-gamemode mangohud lib32-mangohud gamescope) ;;
    office) pkgs=(libreoffice-fresh thunderbird xournalpp hunspell-en_us) ;;
    creative) pkgs=(gimp inkscape krita kdenlive obs-studio blender) ;;
    *) die "Bundles: dev, gaming, office, creative" ;;
  esac
  header "Bundle: $name" "${pkgs[*]}"
  if [[ "$name" == gaming ]] && ! grep -q '^\[multilib\]' /etc/pacman.conf; then
    echo "Steam needs the multilib repository. Enabling it…"
    sudo sed -i '/^#\[multilib\]/,/^#Include/ s/^#//' /etc/pacman.conf
    sudo pacman -Sy
  fi
  add "${pkgs[@]}"
  if [[ "$name" == dev ]]; then
    sudo systemctl enable --now docker.socket
    sudo usermod -aG docker "$USER"
    echo "Log out and back in to use docker without sudo."
  fi
  notify "Bundle installed" "$name" -i system-software-install
  pause
}

case "${1:-install}" in
  install) install ;;
  remove) remove ;;
  popular) popular ;;
  flatpak) flatpak_search ;;
  bundle) bundle "${2:-}" ;;
  add) shift; [[ $# -gt 0 ]] || die "usage: lumen-pkg add PKG..."; add "$@" ;;
  rm) shift; [[ $# -gt 0 ]] || die "usage: lumen-pkg rm PKG..."; sudo pacman -Rns "$@" ;;
  -h | --help | help) sed -n '2,11s/^# \{0,1\}//p' "$0" ;;
  *) die "Unknown command '$1'. See: lumen-pkg --help" ;;
esac
