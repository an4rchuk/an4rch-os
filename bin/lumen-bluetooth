#!/usr/bin/env bash
# lumen-bluetooth — obsolete name (before an4rch OS 1.1.0) of anarch-bluetooth; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-bluetooth is obsolete: use anarch-bluetooth (or: anarch bluetooth)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-bluetooth" "$@"
