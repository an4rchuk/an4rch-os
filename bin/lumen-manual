#!/usr/bin/env bash
# lumen-manual — obsolete name (before An4rch OS 1.1.0) of anarch-manual; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-manual is obsolete: use anarch-manual (or: anarch manual)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-manual" "$@"
