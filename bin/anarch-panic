#!/usr/bin/env bash
# anarch-panic — the panic key (SUPER + SHIFT + Esc): hide everything and lock, at once.
#
#   anarch-panic          close vaults, mute mic and speakers, pause media, wipe
#                         the clipboard, hide notifications, go to an empty
#                         workspace and lock the screen
#   anarch-panic --radios also turn off Wi-Fi and Bluetooth
#
# Set LUMEN_PANIC_RADIOS=yes in ~/.config/lumen/settings.conf to always
# include the radios.
set -uo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

radios="${LUMEN_PANIC_RADIOS:-no}"
case "${1:-}" in
  --radios) radios=yes ;;
  -h | --help) sed -n '2,10s/^# \{0,1\}//p' "$0"; exit 0 ;;
esac

# Lock first and fast: everything else happens behind the lock screen.
hyprctl dispatch 'hl.dsp.focus({ workspace = "empty" })' >/dev/null 2>&1 || true
loginctl lock-session 2>/dev/null || { has hyprlock && launch hyprlock; }

# Encrypted folders close, so their files can't be read even after unlocking.
"$LUMEN_PATH/bin/anarch-vault" close-all --quiet 2>/dev/null || true

if has wpctl; then
  wpctl set-mute @DEFAULT_AUDIO_SINK@ 1 2>/dev/null
  wpctl set-mute @DEFAULT_AUDIO_SOURCE@ 1 2>/dev/null
fi
has playerctl && playerctl --all-players pause 2>/dev/null

has cliphist && cliphist wipe 2>/dev/null
has wl-copy && { wl-copy --clear 2>/dev/null; wl-copy --primary --clear 2>/dev/null; }

has makoctl && makoctl dismiss --all 2>/dev/null

if [[ "$radios" == yes ]]; then
  has nmcli && nmcli radio all off 2>/dev/null
  has bluetoothctl && bluetoothctl power off >/dev/null 2>&1
fi

mkdir -p "$LUMEN_STATE"
date '+%F %T' >"$LUMEN_STATE/last-panic"
exit 0
