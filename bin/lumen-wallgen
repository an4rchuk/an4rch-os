#!/usr/bin/env python3
# lumen-wallgen — paint original wallpapers from a theme's palette.
"""Generate an4rch wallpapers from theme palettes.

Every theme gets a small set of abstract, softly lit wallpapers drawn from its
own colours, so switching themes always lands on a background that matches.
Output is deterministic per theme (seeded), and needs only Pillow.

    lumen-wallgen --all --out ~/.local/share/backgrounds/lumen
    lumen-wallgen --theme nord --size 2560x1440 --out /tmp/walls
"""

from __future__ import annotations

import argparse
import math
import os
import random
import sys
from pathlib import Path

try:
    from PIL import Image, ImageChops, ImageDraw, ImageFilter
except ImportError:  # pragma: no cover - reported to the user
    sys.exit("lumen-wallgen needs Pillow (pacman -S python-pillow)")

LUMEN_PATH = Path(os.environ.get("LUMEN_PATH", Path.home() / ".local/share/lumen"))
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "lumen"


# --- palette helpers ---------------------------------------------------------

def read_theme(path: Path) -> dict[str, str]:
    palette = {}
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        palette[key] = value
    return palette


def rgb(value: str) -> tuple[int, int, int]:
    value = value.lstrip("#")
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))  # type: ignore[return-value]


def mix(a, b, t: float):
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def luminance(c) -> float:
    return (0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]) / 255


# --- finishing touches ---------------------------------------------------------

def vignette(img: Image.Image, amount: float, dark) -> Image.Image:
    w, h = img.size
    small = Image.new("L", (w // 8, h // 8), 0)
    d = ImageDraw.Draw(small)
    sw, sh = small.size
    steps = 60
    for i in range(steps):
        t = i / steps
        v = round(255 * (t ** 2.2))
        d.ellipse(
            (-sw * 0.35 + sw * 0.35 * t, -sh * 0.45 + sh * 0.45 * t,
             sw * 1.35 - sw * 0.35 * t, sh * 1.45 - sh * 0.45 * t),
            fill=255 - v,
        )
    mask = small.filter(ImageFilter.GaussianBlur(sw / 12)).resize((w, h), Image.BICUBIC)
    mask = mask.point(lambda p: round(p * amount))
    return Image.composite(Image.new("RGB", (w, h), dark), img, mask)


def soft_upscale(small: Image.Image, size, blur: float) -> Image.Image:
    return small.filter(ImageFilter.GaussianBlur(blur)).resize(size, Image.BICUBIC)


# --- styles --------------------------------------------------------------------

def aurora(p, size, rnd: random.Random) -> Image.Image:
    """Large, slow colour fields drifting over the background."""
    w, h = size
    sw, sh = w // 10, h // 10
    bg = rgb(p["bg"])
    img = Image.new("RGB", (sw, sh), bg)
    layer = Image.new("RGBA", (sw, sh), (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    if "gradient" in p:  # stay within the theme's own colours
        colours = [rgb(p["accent"]), rgb(p.get("accent2", p["accent"]))] + [c for c, _ in gradient_stops(p)[1:]]
    else:
        colours = [rgb(p[k]) for k in ("accent", "accent2", "purple", "blue", "cyan") if k in p]
    for i in range(7):
        c = colours[i % len(colours)]
        cx = rnd.uniform(-0.1, 1.1) * sw
        cy = rnd.uniform(0.15, 1.1) * sh
        rx = rnd.uniform(0.25, 0.55) * sw
        ry = rnd.uniform(0.12, 0.3) * sh
        alpha = round(rnd.uniform(110, 190) * (0.6 if luminance(bg) > 0.5 else 1))
        d.ellipse((cx - rx, cy - ry, cx + rx, cy + ry), fill=(*c, alpha))
    layer = layer.filter(ImageFilter.GaussianBlur(sw / 9))
    img.paste(layer, (0, 0), layer)
    # A darker sky at the top keeps the bar readable.
    sky = Image.linear_gradient("L").resize((sw, sh)).point(lambda v: 255 - v)
    img = Image.composite(Image.new("RGB", (sw, sh), bg), img, sky.point(lambda v: round(v * 0.4)))
    out = soft_upscale(img, size, sw / 60)
    return out


def dunes(p, size, rnd: random.Random) -> Image.Image:
    """Layered hills under a quiet sky, with a low sun."""
    w, h = size
    bg, bg_alt, bg_hl = rgb(p["bg"]), rgb(p["bg_alt"]), rgb(p["bg_hl"])
    accent, accent2 = rgb(p["accent"]), rgb(p.get("accent2", p["blue"]))
    sky_top = bg
    sky_bottom = mix(bg_alt, accent, 0.18)
    img = Image.new("RGB", size, bg)
    grad = Image.linear_gradient("L").resize(size)
    img = Image.composite(Image.new("RGB", size, sky_bottom), Image.new("RGB", size, sky_top), grad)

    # Sun glow.
    glow = Image.new("RGBA", (w // 8, h // 8), (0, 0, 0, 0))
    gd = ImageDraw.Draw(glow)
    sx, sy, r = glow.width * rnd.uniform(0.6, 0.78), glow.height * 0.5, glow.height * 0.13
    gd.ellipse((sx - r * 3, sy - r * 3, sx + r * 3, sy + r * 3), fill=(*accent2, 60))
    gd.ellipse((sx - r, sy - r, sx + r, sy + r), fill=(*mix(accent2, (255, 255, 255), 0.35), 235))
    glow = glow.filter(ImageFilter.GaussianBlur(r * 0.9)).resize(size, Image.BICUBIC)
    img.paste(glow, (0, 0), glow)

    d = ImageDraw.Draw(img)
    layers = 5
    for i in range(layers):
        t = i / (layers - 1)
        base = h * (0.55 + 0.1 * i)
        amp = h * (0.06 - 0.008 * i)
        f1, f2 = rnd.uniform(0.6, 1.4), rnd.uniform(1.8, 3.2)
        ph1, ph2 = rnd.uniform(0, math.tau), rnd.uniform(0, math.tau)
        pts = [(0, h)]
        for x in range(0, w + 16, 16):
            u = x / w
            y = base + amp * math.sin(u * math.tau * f1 + ph1) + amp * 0.35 * math.sin(u * math.tau * f2 + ph2)
            pts.append((x, y))
        pts.append((w, h))
        col = mix(mix(bg_hl, accent, 0.35 * (1 - t)), bg, 0.25 + 0.6 * t)
        d.polygon(pts, fill=col)
    return img


def orbit(p, size, rnd: random.Random) -> Image.Image:
    """Minimal: a single glow and fine orbital lines."""
    w, h = size
    bg = rgb(p["bg"])
    accent, accent2, fg_dim = rgb(p["accent"]), rgb(p.get("accent2", p["blue"])), rgb(p["fg_dim"])
    img = Image.new("RGB", size, bg)

    glow = Image.new("RGBA", (w // 8, h // 8), (0, 0, 0, 0))
    gd = ImageDraw.Draw(glow)
    cx, cy = glow.width * 0.68, glow.height * 0.62
    for rr, col, a in ((0.55, accent, 70), (0.32, accent2, 80), (0.14, accent, 120)):
        r = glow.height * rr
        gd.ellipse((cx - r, cy - r, cx + r, cy + r), fill=(*col, a))
    glow = glow.filter(ImageFilter.GaussianBlur(glow.height * 0.12)).resize(size, Image.BICUBIC)
    img.paste(glow, (0, 0), glow)

    # Supersampled thin rings.
    ss = 2
    lines = Image.new("RGBA", (w * ss // 2, h * ss // 2), (0, 0, 0, 0))
    ld = ImageDraw.Draw(lines)
    lcx, lcy = lines.width * 0.68, lines.height * 0.62
    for i in range(9):
        r = lines.height * (0.16 + i * 0.085)
        alpha = round(70 - i * 6)
        ld.ellipse((lcx - r, lcy - r, lcx + r, lcy + r), outline=(*fg_dim, max(alpha, 14)), width=max(1, ss))
    # A small planet on one ring.
    ang = rnd.uniform(math.pi * 0.9, math.pi * 1.3)
    r = lines.height * (0.16 + 3 * 0.085)
    px, py = lcx + r * math.cos(ang), lcy + r * math.sin(ang)
    pr = lines.height * 0.012
    ld.ellipse((px - pr, py - pr, px + pr, py + pr), fill=(*accent2, 255))
    lines = lines.resize(size, Image.LANCZOS)
    img.paste(lines, (0, 0), lines)
    return img


def silk(p, size, rnd: random.Random) -> Image.Image:
    """Diagonal light falling across soft folds."""
    w, h = size
    sw, sh = w // 6, h // 6
    bg, bg_alt = rgb(p["bg"]), rgb(p["bg_alt"])
    accent = rgb(p["accent"])
    purple = rgb(p["accent2"] if "gradient" in p else p.get("purple", p["accent"]))
    img = Image.new("RGB", (sw, sh), bg)
    d = ImageDraw.Draw(img)
    folds = 9
    for i in range(folds):
        t = i / folds
        col = mix(mix(bg_alt, accent if i % 2 else purple, 0.12 + 0.2 * math.sin(t * math.pi)), bg, 0.2)
        off = rnd.uniform(-0.05, 0.05) * sw
        x0 = -sw * 0.6 + i * sw * 0.22 + off
        d.polygon([(x0, sh), (x0 + sw * 0.55, 0), (x0 + sw * 0.75, 0), (x0 + sw * 0.2, sh)], fill=col)
    out = soft_upscale(img, size, sw / 30)
    return out


# --- gradients -------------------------------------------------------------------
# A theme can describe its own gradient in theme.conf, CSS style:
#   gradient = #0b0b0b 0%, #2a070d 40%, #7a0a1c 70%, #c8102e 100%
#   gradient_angle = 135
# Themes without one get a gradient from their background to their accent.

def gradient_stops(p) -> list[tuple[tuple[int, int, int], float]]:
    stops = []
    for part in p.get("gradient", "").split(","):
        bits = part.split()
        if not bits or not bits[0].startswith("#"):
            continue
        pos = float(bits[1].rstrip("%")) / 100 if len(bits) > 1 else None
        stops.append([rgb(bits[0]), pos])
    if len(stops) < 2:
        bg, bg_alt, accent = rgb(p["bg"]), rgb(p["bg_alt"]), rgb(p["accent"])
        return [(bg, 0.0), (mix(bg_alt, accent, 0.25), 0.4), (mix(bg, accent, 0.6), 0.75), (accent, 1.0)]
    # Stops without a position are spread evenly, like CSS.
    if stops[0][1] is None:
        stops[0][1] = 0.0
    if stops[-1][1] is None:
        stops[-1][1] = 1.0
    i = 0
    while i < len(stops):
        if stops[i][1] is None:
            j = i
            while stops[j][1] is None:
                j += 1
            a, b = stops[i - 1][1], stops[j][1]
            for k in range(i, j):
                stops[k][1] = a + (b - a) * (k - i + 1) / (j - i + 1)
            i = j
        i += 1
    return [(tuple(c), max(0.0, min(1.0, t))) for c, t in stops]


def _lin(v: float) -> float:
    v /= 255
    return v / 12.92 if v <= 0.04045 else ((v + 0.055) / 1.055) ** 2.4


def _srgb(v: float) -> int:
    v = max(0.0, v)
    v = v * 12.92 if v <= 0.0031308 else 1.055 * v ** (1 / 2.4) - 0.055
    return max(0, min(255, round(v * 255)))


def ramp(stops, n: int = 1024):
    """n colours along the gradient, mixed in linear light along a smooth
    (monotone cubic) curve through the stops: the colours flow into each
    other over a long, even stretch with no visible lines where stops meet."""
    xs = [t for _, t in stops]
    chans = [[_lin(c[i]) for c, _ in stops] for i in range(3)]
    m = len(xs)

    def slopes(ys):
        d = [(ys[k + 1] - ys[k]) / ((xs[k + 1] - xs[k]) or 1e-6) for k in range(m - 1)]
        tang = [d[0]] + [0.0 if d[k - 1] * d[k] <= 0 else (d[k - 1] + d[k]) / 2 for k in range(1, m - 1)] + [d[-1]]
        for k in range(m - 1):  # Fritsch-Carlson: no overshoot
            if d[k] == 0:
                tang[k] = tang[k + 1] = 0.0
                continue
            a, b = tang[k] / d[k], tang[k + 1] / d[k]
            if a * a + b * b > 9:
                s_ = 3 / math.sqrt(a * a + b * b)
                tang[k], tang[k + 1] = s_ * a * d[k], s_ * b * d[k]
        return tang

    tangents = [slopes(ys) for ys in chans]
    out = []
    k = 0
    for i in range(n):
        t = i / (n - 1)
        while k < m - 2 and t > xs[k + 1]:
            k += 1
        h = (xs[k + 1] - xs[k]) or 1e-6
        u = min(1.0, max(0.0, (t - xs[k]) / h))
        h00, h10 = 2 * u ** 3 - 3 * u ** 2 + 1, u ** 3 - 2 * u ** 2 + u
        h01, h11 = -2 * u ** 3 + 3 * u ** 2, u ** 3 - u ** 2
        out.append(tuple(_srgb(h00 * ys[k] + h10 * h * tg[k] + h01 * ys[k + 1] + h11 * h * tg[k + 1])
                         for ys, tg in zip(chans, tangents)))
    return out


def paint(size, position, colours) -> Image.Image:
    """Colour every pixel by position(x, y) -> 0..1 along the gradient."""
    w, h = size
    n = len(colours) - 1
    data = []
    for y in range(h):
        for x in range(w):
            t = position(x, y)
            data.append(colours[round(min(1.0, max(0.0, t)) * n)])
    img = Image.new("RGB", size)
    img.putdata(data)
    return img


def linear(size, angle: float):
    """CSS-style linear gradient positions (angle in degrees, 0 = to top)."""
    w, h = size
    a = math.radians(angle)
    dx, dy = math.sin(a), -math.cos(a)
    length = abs(w * dx) + abs(h * dy)
    cx, cy = w / 2, h / 2
    return lambda x, y: ((x - cx) * dx + (y - cy) * dy) / length + 0.5


def sweep(p, size, rnd: random.Random) -> Image.Image:
    """The theme's gradient corner to corner, long and even."""
    w, h = size
    small = (w // 12, h // 12)
    angle = float(p.get("gradient_angle", 135))
    return soft_upscale(paint(small, linear(small, angle), ramp(gradient_stops(p))), size, 1)


def rise(p, size, rnd: random.Random) -> Image.Image:
    """Dark at the top, the accent rising from the bottom edge."""
    w, h = size
    small = (w // 12, h // 12)
    pos = linear(small, 180)
    return soft_upscale(paint(small, lambda x, y: pos(x, y) ** 1.6, ramp(gradient_stops(p))), size, 1)


def glow(p, size, rnd: random.Random) -> Image.Image:
    """Light spreading out from one corner."""
    w, h = size
    sw, sh = w // 12, h // 12
    cx, cy = rnd.choice(((sw, sh), (0, sh), (sw * 0.85, 0)))
    radius = math.hypot(sw, sh) * 0.9
    pos = lambda x, y: 1 - math.hypot((x - cx), (y - cy) * 1.25) / radius
    return soft_upscale(paint((sw, sh), pos, ramp(gradient_stops(p))), size, 1)


def horizon(p, size, rnd: random.Random) -> Image.Image:
    """A band of light low on the screen, fading up into the dark."""
    w, h = size
    sw, sh = w // 12, h // 12
    line = rnd.uniform(0.66, 0.74)

    def pos(x, y):
        v = y / sh
        if v <= line:
            return (v / line) ** 2.4
        return max(0.0, 1 - ((v - line) / (1 - line)) ** 1.1 * 0.7)
    return soft_upscale(paint((sw, sh), pos, ramp(gradient_stops(p))), size, 2)


def mesh(p, size, rnd: random.Random) -> Image.Image:
    """Soft pools of the gradient's colours drifting over it."""
    w, h = size
    sw, sh = w // 8, h // 8
    colours = ramp(gradient_stops(p))
    img = paint((sw, sh), linear((sw, sh), rnd.choice((120, 150, 200, 240))), colours)
    for _ in range(5):
        c = colours[round(rnd.uniform(0.35, 1.0) * (len(colours) - 1))]
        cx, cy = rnd.uniform(-0.1, 1.1) * sw, rnd.uniform(0.1, 1.1) * sh
        r = rnd.uniform(0.25, 0.5) * sw
        mask = Image.new("L", (sw, sh), 0)
        ImageDraw.Draw(mask).ellipse((cx - r, cy - r * 0.6, cx + r, cy + r * 0.6), fill=round(rnd.uniform(90, 150)))
        mask = mask.filter(ImageFilter.GaussianBlur(r * 0.5))
        img = Image.composite(Image.new("RGB", (sw, sh), c), img, mask)
    # A darker top keeps the bar readable.
    top = Image.linear_gradient("L").resize((sw, sh)).point(lambda v: round((255 - v) * 0.5))
    img = Image.composite(Image.new("RGB", (sw, sh), colours[0]), img, top)
    return soft_upscale(img, size, sw / 50)


GRADIENTS = ("sweep", "glow", "horizon", "rise", "mesh")
STYLES = {"sweep": sweep, "glow": glow, "horizon": horizon, "rise": rise, "mesh": mesh,
          "aurora": aurora, "dunes": dunes, "orbit": orbit, "silk": silk}


def render(theme: str, palette: dict[str, str], out_dir: Path, size, styles) -> list[Path]:
    out_dir.mkdir(parents=True, exist_ok=True)
    written = []
    bg = rgb(palette["bg"])
    for n, style in enumerate(styles, start=1):
        seed = sum(ord(c) for c in theme) * 97 + n
        rnd = random.Random(seed)
        img = STYLES[style](palette, size, rnd)
        if style not in GRADIENTS:  # gradients carry their own light and shade
            img = vignette(img, 0.35 if luminance(bg) < 0.5 else 0.12, mix(bg, (0, 0, 0), 0.4))
        img = Image.blend(img, ImageChops.overlay(img, Image.effect_noise(size, 40).convert("RGB")), 0.06)
        # High-quality JPEG: the grain hides any compression artefacts and
        # saving is ~50x faster than an optimised PNG.
        path = out_dir / f"{n:02d}-{style}.jpg"
        img.save(path, quality=94, subsampling=0)
        written.append(path)
    # Drop wallpapers an earlier version painted under other numbers.
    for old in out_dir.glob("[0-9][0-9]-*.jpg"):
        if old not in written and old.stem.split("-", 1)[1] in STYLES:
            old.unlink()
    return written


def theme_dirs():
    seen = {}
    for root in (LUMEN_PATH / "themes", CONFIG / "themes"):
        if root.is_dir():
            for d in sorted(root.iterdir()):
                if (d / "theme.conf").is_file():
                    seen[d.name] = d
    return seen


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--theme", action="append", help="theme to render (repeatable)")
    ap.add_argument("--all", action="store_true", help="render every installed theme")
    ap.add_argument("--out", type=Path, required=True, help="output root; files go in OUT/<theme>/")
    ap.add_argument("--size", default="3840x2160", help="WIDTHxHEIGHT (default 3840x2160)")
    ap.add_argument("--styles", default=",".join(STYLES), help=f"comma list from: {', '.join(STYLES)}")
    args = ap.parse_args()

    w, h = (int(v) for v in args.size.lower().split("x"))
    styles = [s for s in args.styles.split(",") if s]
    unknown = [s for s in styles if s not in STYLES]
    if unknown:
        ap.error(f"unknown style(s): {', '.join(unknown)}")

    themes = theme_dirs()
    names = list(themes) if args.all else (args.theme or [])
    if not names:
        ap.error("pass --all or --theme NAME")
    for name in names:
        if name not in themes:
            # Themes from a pack that isn't installed yet (for previews).
            found = sorted((LUMEN_PATH / "themes-extra").glob(f"*/{name}/theme.conf"))
            if found:
                themes[name] = found[0].parent
        if name not in themes:
            print(f"skipping unknown theme {name}", file=sys.stderr)
            continue
        palette = read_theme(themes[name] / "theme.conf")
        paths = render(name, palette, args.out / name, (w, h), styles)
        print(f"{name}: {len(paths)} wallpapers")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
