#!/usr/bin/env bash
# lumen-wallgen — obsolete name (before An4rch OS 1.1.0) of anarch-wallgen; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-wallgen is obsolete: use anarch-wallgen (or: anarch wallgen)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-wallgen" "$@"
