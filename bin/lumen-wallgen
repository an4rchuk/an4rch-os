#!/usr/bin/env python3
# lumen-wallgen — paint original wallpapers from a theme's palette.
"""Generate Lumen wallpapers from theme palettes.

Every theme gets a small set of abstract, softly lit wallpapers drawn from its
own colours, so switching themes always lands on a background that matches.
Output is deterministic per theme (seeded), and needs only Pillow.

    lumen-wallgen --all --out ~/.local/share/backgrounds/lumen
    lumen-wallgen --theme nord --size 2560x1440 --out /tmp/walls
"""

from __future__ import annotations

import argparse
import math
import os
import random
import sys
from pathlib import Path

try:
    from PIL import Image, ImageChops, ImageDraw, ImageFilter
except ImportError:  # pragma: no cover - reported to the user
    sys.exit("lumen-wallgen needs Pillow (pacman -S python-pillow)")

LUMEN_PATH = Path(os.environ.get("LUMEN_PATH", Path.home() / ".local/share/lumen"))
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "lumen"


# --- palette helpers ---------------------------------------------------------

def read_theme(path: Path) -> dict[str, str]:
    palette = {}
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        palette[key] = value
    return palette


def rgb(value: str) -> tuple[int, int, int]:
    value = value.lstrip("#")
    return tuple(int(value[i:i + 2], 16) for i in (0, 2, 4))  # type: ignore[return-value]


def mix(a, b, t: float):
    return tuple(round(x + (y - x) * t) for x, y in zip(a, b))


def luminance(c) -> float:
    return (0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]) / 255


# --- finishing touches ---------------------------------------------------------

def vignette(img: Image.Image, amount: float, dark) -> Image.Image:
    w, h = img.size
    small = Image.new("L", (w // 8, h // 8), 0)
    d = ImageDraw.Draw(small)
    sw, sh = small.size
    steps = 60
    for i in range(steps):
        t = i / steps
        v = round(255 * (t ** 2.2))
        d.ellipse(
            (-sw * 0.35 + sw * 0.35 * t, -sh * 0.45 + sh * 0.45 * t,
             sw * 1.35 - sw * 0.35 * t, sh * 1.45 - sh * 0.45 * t),
            fill=255 - v,
        )
    mask = small.filter(ImageFilter.GaussianBlur(sw / 12)).resize((w, h), Image.BICUBIC)
    mask = mask.point(lambda p: round(p * amount))
    return Image.composite(Image.new("RGB", (w, h), dark), img, mask)


def soft_upscale(small: Image.Image, size, blur: float) -> Image.Image:
    return small.filter(ImageFilter.GaussianBlur(blur)).resize(size, Image.BICUBIC)


# --- styles --------------------------------------------------------------------

def aurora(p, size, rnd: random.Random) -> Image.Image:
    """Large, slow colour fields drifting over the background."""
    w, h = size
    sw, sh = w // 10, h // 10
    bg = rgb(p["bg"])
    img = Image.new("RGB", (sw, sh), bg)
    layer = Image.new("RGBA", (sw, sh), (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)
    colours = [rgb(p[k]) for k in ("accent", "accent2", "purple", "blue", "cyan") if k in p]
    for i in range(7):
        c = colours[i % len(colours)]
        cx = rnd.uniform(-0.1, 1.1) * sw
        cy = rnd.uniform(0.15, 1.1) * sh
        rx = rnd.uniform(0.25, 0.55) * sw
        ry = rnd.uniform(0.12, 0.3) * sh
        alpha = round(rnd.uniform(110, 190) * (0.6 if luminance(bg) > 0.5 else 1))
        d.ellipse((cx - rx, cy - ry, cx + rx, cy + ry), fill=(*c, alpha))
    layer = layer.filter(ImageFilter.GaussianBlur(sw / 9))
    img.paste(layer, (0, 0), layer)
    # A darker sky at the top keeps the bar readable.
    sky = Image.linear_gradient("L").resize((sw, sh)).point(lambda v: 255 - v)
    img = Image.composite(Image.new("RGB", (sw, sh), bg), img, sky.point(lambda v: round(v * 0.4)))
    out = soft_upscale(img, size, sw / 60)
    return out


def dunes(p, size, rnd: random.Random) -> Image.Image:
    """Layered hills under a quiet sky, with a low sun."""
    w, h = size
    bg, bg_alt, bg_hl = rgb(p["bg"]), rgb(p["bg_alt"]), rgb(p["bg_hl"])
    accent, accent2 = rgb(p["accent"]), rgb(p.get("accent2", p["blue"]))
    sky_top = bg
    sky_bottom = mix(bg_alt, accent, 0.18)
    img = Image.new("RGB", size, bg)
    grad = Image.linear_gradient("L").resize(size)
    img = Image.composite(Image.new("RGB", size, sky_bottom), Image.new("RGB", size, sky_top), grad)

    # Sun glow.
    glow = Image.new("RGBA", (w // 8, h // 8), (0, 0, 0, 0))
    gd = ImageDraw.Draw(glow)
    sx, sy, r = glow.width * rnd.uniform(0.6, 0.78), glow.height * 0.5, glow.height * 0.13
    gd.ellipse((sx - r * 3, sy - r * 3, sx + r * 3, sy + r * 3), fill=(*accent2, 60))
    gd.ellipse((sx - r, sy - r, sx + r, sy + r), fill=(*mix(accent2, (255, 255, 255), 0.35), 235))
    glow = glow.filter(ImageFilter.GaussianBlur(r * 0.9)).resize(size, Image.BICUBIC)
    img.paste(glow, (0, 0), glow)

    d = ImageDraw.Draw(img)
    layers = 5
    for i in range(layers):
        t = i / (layers - 1)
        base = h * (0.55 + 0.1 * i)
        amp = h * (0.06 - 0.008 * i)
        f1, f2 = rnd.uniform(0.6, 1.4), rnd.uniform(1.8, 3.2)
        ph1, ph2 = rnd.uniform(0, math.tau), rnd.uniform(0, math.tau)
        pts = [(0, h)]
        for x in range(0, w + 16, 16):
            u = x / w
            y = base + amp * math.sin(u * math.tau * f1 + ph1) + amp * 0.35 * math.sin(u * math.tau * f2 + ph2)
            pts.append((x, y))
        pts.append((w, h))
        col = mix(mix(bg_hl, accent, 0.35 * (1 - t)), bg, 0.25 + 0.6 * t)
        d.polygon(pts, fill=col)
    return img


def orbit(p, size, rnd: random.Random) -> Image.Image:
    """Minimal: a single glow and fine orbital lines."""
    w, h = size
    bg = rgb(p["bg"])
    accent, accent2, fg_dim = rgb(p["accent"]), rgb(p.get("accent2", p["blue"])), rgb(p["fg_dim"])
    img = Image.new("RGB", size, bg)

    glow = Image.new("RGBA", (w // 8, h // 8), (0, 0, 0, 0))
    gd = ImageDraw.Draw(glow)
    cx, cy = glow.width * 0.68, glow.height * 0.62
    for rr, col, a in ((0.55, accent, 70), (0.32, accent2, 80), (0.14, accent, 120)):
        r = glow.height * rr
        gd.ellipse((cx - r, cy - r, cx + r, cy + r), fill=(*col, a))
    glow = glow.filter(ImageFilter.GaussianBlur(glow.height * 0.12)).resize(size, Image.BICUBIC)
    img.paste(glow, (0, 0), glow)

    # Supersampled thin rings.
    ss = 2
    lines = Image.new("RGBA", (w * ss // 2, h * ss // 2), (0, 0, 0, 0))
    ld = ImageDraw.Draw(lines)
    lcx, lcy = lines.width * 0.68, lines.height * 0.62
    for i in range(9):
        r = lines.height * (0.16 + i * 0.085)
        alpha = round(70 - i * 6)
        ld.ellipse((lcx - r, lcy - r, lcx + r, lcy + r), outline=(*fg_dim, max(alpha, 14)), width=max(1, ss))
    # A small planet on one ring.
    ang = rnd.uniform(math.pi * 0.9, math.pi * 1.3)
    r = lines.height * (0.16 + 3 * 0.085)
    px, py = lcx + r * math.cos(ang), lcy + r * math.sin(ang)
    pr = lines.height * 0.012
    ld.ellipse((px - pr, py - pr, px + pr, py + pr), fill=(*accent2, 255))
    lines = lines.resize(size, Image.LANCZOS)
    img.paste(lines, (0, 0), lines)
    return img


def silk(p, size, rnd: random.Random) -> Image.Image:
    """Diagonal light falling across soft folds."""
    w, h = size
    sw, sh = w // 6, h // 6
    bg, bg_alt = rgb(p["bg"]), rgb(p["bg_alt"])
    accent, purple = rgb(p["accent"]), rgb(p.get("purple", p["accent"]))
    img = Image.new("RGB", (sw, sh), bg)
    d = ImageDraw.Draw(img)
    folds = 9
    for i in range(folds):
        t = i / folds
        col = mix(mix(bg_alt, accent if i % 2 else purple, 0.12 + 0.2 * math.sin(t * math.pi)), bg, 0.2)
        off = rnd.uniform(-0.05, 0.05) * sw
        x0 = -sw * 0.6 + i * sw * 0.22 + off
        d.polygon([(x0, sh), (x0 + sw * 0.55, 0), (x0 + sw * 0.75, 0), (x0 + sw * 0.2, sh)], fill=col)
    out = soft_upscale(img, size, sw / 30)
    return out


STYLES = {"aurora": aurora, "dunes": dunes, "orbit": orbit, "silk": silk}


def render(theme: str, palette: dict[str, str], out_dir: Path, size, styles) -> list[Path]:
    out_dir.mkdir(parents=True, exist_ok=True)
    written = []
    bg = rgb(palette["bg"])
    for n, style in enumerate(styles, start=1):
        seed = sum(ord(c) for c in theme) * 97 + n
        rnd = random.Random(seed)
        img = STYLES[style](palette, size, rnd)
        img = vignette(img, 0.35 if luminance(bg) < 0.5 else 0.12, mix(bg, (0, 0, 0), 0.4))
        img = Image.blend(img, ImageChops.overlay(img, Image.effect_noise(size, 40).convert("RGB")), 0.06)
        # High-quality JPEG: the grain hides any compression artefacts and
        # saving is ~50x faster than an optimised PNG.
        path = out_dir / f"{n:02d}-{style}.jpg"
        img.save(path, quality=94, subsampling=0)
        written.append(path)
    return written


def theme_dirs():
    seen = {}
    for root in (LUMEN_PATH / "themes", CONFIG / "themes"):
        if root.is_dir():
            for d in sorted(root.iterdir()):
                if (d / "theme.conf").is_file():
                    seen[d.name] = d
    return seen


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--theme", action="append", help="theme to render (repeatable)")
    ap.add_argument("--all", action="store_true", help="render every installed theme")
    ap.add_argument("--out", type=Path, required=True, help="output root; files go in OUT/<theme>/")
    ap.add_argument("--size", default="3840x2160", help="WIDTHxHEIGHT (default 3840x2160)")
    ap.add_argument("--styles", default=",".join(STYLES), help=f"comma list from: {', '.join(STYLES)}")
    args = ap.parse_args()

    w, h = (int(v) for v in args.size.lower().split("x"))
    styles = [s for s in args.styles.split(",") if s]
    unknown = [s for s in styles if s not in STYLES]
    if unknown:
        ap.error(f"unknown style(s): {', '.join(unknown)}")

    themes = theme_dirs()
    names = list(themes) if args.all else (args.theme or [])
    if not names:
        ap.error("pass --all or --theme NAME")
    for name in names:
        if name not in themes:
            print(f"skipping unknown theme {name}", file=sys.stderr)
            continue
        palette = read_theme(themes[name] / "theme.conf")
        paths = render(name, palette, args.out / name, (w, h), styles)
        print(f"{name}: {len(paths)} wallpapers")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
