#!/usr/bin/env python3
# lumen-window — minimise and restore windows (Hyprland has no minimise of its own).
#
#   lumen-window minimize [ADDRESS]   hide the active (or given) window
#   lumen-window restore [ADDRESS]    bring a window back (default: the last one hidden)
#   lumen-window restore-menu         pick a hidden window from a menu (SUPER + SHIFT + M)
#   lumen-window list                 print hidden windows
#   lumen-window daemon               follow taskbar minimise/restore clicks (started with the session)
#
# Minimised windows wait on a hidden workspace, "special:minimized". The
# minimise button on title bars and the taskbar both use it; clicking a
# minimised window in the taskbar brings it back where you are.
import json
import os
import socket
import subprocess
import sys

HIDDEN = "special:minimized"


def hyprctl(*args):
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True).stdout


def query(what):
    try:
        return json.loads(hyprctl("-j", what) or "null")
    except json.JSONDecodeError:
        return None


def dispatch(lua):
    subprocess.run(["hyprctl", "dispatch", lua], capture_output=True)


def hidden_windows():
    clients = query("clients") or []
    hidden = [c for c in clients if c.get("workspace", {}).get("name") == HIDDEN]
    # Most recently focused first.
    return sorted(hidden, key=lambda c: c.get("focusHistoryID", 0))


def norm(address):
    address = address.strip()
    return address if address.startswith("0x") else "0x" + address


def minimize(address=None):
    if address is None:
        active = query("activewindow") or {}
        address = active.get("address")
        if not address:
            return
    dispatch(f'hl.dsp.window.move({{ workspace = "{HIDDEN}", follow = false, window = "address:{norm(address)}" }})')


def restore(address=None):
    if address is None:
        hidden = hidden_windows()
        if not hidden:
            return
        address = hidden[0]["address"]
    workspace = (query("activeworkspace") or {}).get("id", 1)
    if workspace is None or workspace < 0:
        workspace = 1
    address = norm(address)
    dispatch(f'hl.dsp.window.move({{ workspace = {workspace}, follow = true, window = "address:{address}" }})')
    dispatch(f'hl.dsp.focus({{ window = "address:{address}" }})')


def restore_menu():
    hidden = hidden_windows()
    if not hidden:
        subprocess.run(["notify-send", "-a", "Lumen", "No minimised windows", "", "-t", "2000"])
        return
    lines = [f'{c.get("class", "?")} — {c.get("title", "")}' for c in hidden]
    pick = subprocess.run(["fuzzel", "--dmenu", "--index", "--prompt", "Restore  ", "--lines", str(len(lines))],
                          input="\n".join(lines), capture_output=True, text=True)
    if pick.returncode == 0 and pick.stdout.strip().isdigit():
        restore(hidden[int(pick.stdout.strip())]["address"])


def is_hidden(address):
    return any(c["address"] == norm(address) for c in hidden_windows())


def daemon():
    runtime = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    path = os.path.join(runtime, "hypr", sig, ".socket2.sock")
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.connect(path)
    buf = b""
    while True:
        data = sock.recv(4096)
        if not data:
            return
        buf += data
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            event, _, value = line.decode(errors="replace").partition(">>")
            if event == "minimized":
                # A taskbar asked to minimise (…,1) or restore (…,0) a window.
                address, _, state = value.partition(",")
                if state == "1":
                    minimize(address)
                elif is_hidden(address):
                    restore(address)
            elif event == "activewindowv2" and value and is_hidden(value):
                # Clicking a minimised window in the taskbar activates it.
                restore(value)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "restore-menu"
    arg = argv[2] if len(argv) > 2 else None
    if cmd in ("minimize", "minimise"):
        minimize(arg)
    elif cmd == "restore":
        restore(arg)
    elif cmd == "restore-menu":
        restore_menu()
    elif cmd == "list":
        for c in hidden_windows():
            print(f'{c["address"]}  {c.get("class", "?")} — {c.get("title", "")}')
    elif cmd == "daemon":
        daemon()
    elif cmd in ("-h", "--help", "help"):
        with open(__file__) as f:
            for line in f.readlines()[1:13]:
                print(line[2:].rstrip())
    else:
        print(f"Unknown command '{cmd}'. See: lumen-window --help", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
