#!/usr/bin/env bash
# lumen-update — obsolete name (before An4rch OS 1.1.0) of anarch-update; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-update is obsolete: use anarch-update (or: anarch update)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-update" "$@"
