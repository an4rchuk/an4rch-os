#!/usr/bin/env bash
# lumen-update — update Lumen, system packages, Flatpaks and firmware (SUPER + ALT + U).
#
#   lumen-update           everything
#   lumen-update lumen     only Lumen itself
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

if [[ ! -t 0 ]]; then
  term --float --title "Update" -- "$0" "$@"
  exit 0
fi

step() { printf '\n\e[1;35m󰚰  %s\e[0m\n\n' "$*"; }

update_lumen() {
  step "Lumen"
  if [[ ! -d "$LUMEN_PATH/.git" ]]; then
    echo "  $LUMEN_PATH is not a git checkout; skipping."
    return 0
  fi
  local g=(git -C "$LUMEN_PATH") repo="${LUMEN_REPO:-https://github.com/an4rchuk/lumen-os.git}"
  local before latest target
  # Older installs point at an address that no longer exists (GitHub then
  # asks for a login); never prompt, just fail with a message.
  export GIT_TERMINAL_PROMPT=0
  if [[ "$("${g[@]}" remote get-url origin 2>/dev/null)" != "$repo" ]]; then
    "${g[@]}" remote set-url origin "$repo" 2>/dev/null || "${g[@]}" remote add origin "$repo"
  fi
  "${g[@]}" config core.fileMode false
  if ! "${g[@]}" fetch --quiet --force --tags origin; then
    echo "  Couldn't reach GitHub (no internet?); Lumen stays as it is."
    return 0
  fi
  # Updates follow the releases (v1.0.8, v1.0.9, …), the same code as the ISOs.
  latest=$("${g[@]}" tag -l 'v[0-9]*' --sort=-v:refname | head -n1)
  before=$("${g[@]}" rev-parse HEAD)
  target=$("${g[@]}" rev-parse "${latest:-HEAD}^{commit}" 2>/dev/null || echo "$before")
  if [[ -z "$latest" || "$target" == "$before" ]] || "${g[@]}" merge-base --is-ancestor "$target" "$before" 2>/dev/null; then
    echo "  Already up to date ($("${g[@]}" describe --tags --always 2>/dev/null))."
    return 0
  fi
  # Edits to Lumen's own files are kept in a stash (git stash list), not lost.
  "${g[@]}" stash push --quiet -m "lumen update $(date '+%F %T')" 2>/dev/null || true
  if ! "${g[@]}" checkout --quiet --detach "$latest" 2>/dev/null; then
    "${g[@]}" checkout --quiet --force --detach "$latest"
  fi
  echo "  Updated to $latest:"
  "${g[@]}" log --oneline --no-decorate "$before..$target" 2>/dev/null | head -n 30 | sed 's/^/  /'
  bash "$LUMEN_PATH/install/migrate.sh"
  "$LUMEN_PATH/bin/lumen-theme" render >/dev/null || true
}

update_system() {
  step "System packages"
  if has yay; then
    yay -Syu
  elif has paru; then
    paru -Syu
  else
    sudo pacman -Syu
  fi

  # A new Hyprland needs the title bar plugin rebuilt for it.
  if [[ "${LUMEN_TITLEBARS:-yes}" == yes && -f /usr/lib/lumen/hyprbars.so ]]; then
    step "Window title bars"
    LUMEN_YES=1 "$LUMEN_PATH/bin/lumen-titlebars" setup </dev/null || echo "  Title bars could not be rebuilt; run: lumen titlebars setup --force"
  fi

  if has flatpak && [[ -n "$(flatpak list --app --columns=application 2>/dev/null)" ]]; then
    step "Flatpak apps"
    flatpak update -y
  fi

  if has fwupdmgr; then
    step "Firmware"
    fwupdmgr refresh --force >/dev/null 2>&1 || true
    if fwupdmgr get-updates >/dev/null 2>&1; then
      fwupdmgr get-updates || true
      read -rp "Install firmware updates now? [y/N] " yn
      [[ "$yn" == [yY]* ]] && fwupdmgr update
    else
      echo "  No firmware updates."
    fi
  fi

  # Pacman keeps new versions of edited config files as .pacnew.
  if has pacdiff && find /etc -name '*.pacnew' 2>/dev/null | grep -q .; then
    step "Config files to review"
    find /etc -name '*.pacnew' 2>/dev/null | sed 's/^/  /'
    echo "  Review them with: sudo pacdiff"
  fi
}

case "${1:-all}" in
  lumen) update_lumen ;;
  all) update_lumen; update_system ;;
  *) die "usage: lumen-update [all|lumen]" ;;
esac

bar_signal updates
# After a kernel upgrade the running kernel's modules are gone: time to reboot.
if [[ ! -d "/usr/lib/modules/$(uname -r)" ]]; then
  printf '\n\e[33m󰜉  A new kernel was installed — restart when convenient.\e[0m\n'
fi
printf '\n\e[1;32m✓ All done.\e[0m\n'
printf '\e[2mPress any key to close…\e[0m'
read -rsn1
