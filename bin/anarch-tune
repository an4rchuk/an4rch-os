#!/usr/bin/env bash
# anarch-tune — performance tuning, CachyOS-style.
#
#   anarch-tune                       pick a tweak from a menu
#   anarch-tune status                show kernel, CPU scheduler, I/O, memory and gaming tweaks
#   anarch-tune scheduler NAME        sched-ext CPU scheduler: bpfland, lavd, rusty, flash, off
#   anarch-tune kernel NAME           add a kernel to the boot menu: zen, hardened, lts or linux
#   anarch-tune kernel remove-NAME    take it away again
#   anarch-tune mirrors               rank Arch mirrors by speed now (and weekly from now on)
#
# an4rch OS already ships the low-risk tweaks (see install/distro.sh): tuned
# sysctls for zram and desktops, per-device I/O schedulers, NTSYNC for Wine
# and Proton, faster shutdowns. These are the opt-in ones.
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"
source "$LUMEN_PATH/install/packages.sh"

# Interactive steps need a terminal: from a key binding or menu, open one.
case "${1:-}" in
  "" | pick | status | list | -h | --help | help) ;;
  *) [[ -t 0 ]] || { term --float --hold --title "Performance" -- "$0" "$@"; exit 0; } ;;
esac

say() { printf '\n\e[1;35m󰓅  %s\e[0m\n' "$*"; }
ok() { printf '  \e[32m✓\e[0m %-22s %s\n' "$1" "$2"; }
off() { printf '  \e[2m·\e[0m %-22s %s\n' "$1" "$2"; }
add() { "$LUMEN_PATH/bin/anarch-pkg" add "$@"; }

# --- status --------------------------------------------------------------------------
current_scheduler() {
  local state=/sys/kernel/sched_ext/state
  if [[ -r $state && "$(cat $state)" == enabled ]]; then
    cat /sys/kernel/sched_ext/root/ops 2>/dev/null || echo "sched-ext"
  else
    echo "default (EEVDF)"
  fi
}

status() {
  say "Performance"
  ok "Kernel" "$(uname -r)"
  if [[ "$(current_scheduler)" == default* ]]; then off "CPU scheduler" "$(current_scheduler)"; else ok "CPU scheduler" "$(current_scheduler)"; fi
  local gov
  gov=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo unknown)
  ok "CPU governor" "$gov"
  has powerprofilesctl && ok "Power profile" "$(powerprofilesctl get 2>/dev/null || echo unknown)"
  if [[ -e /sys/block/zram0 ]]; then
    ok "zram swap" "$(lsblk -dno SIZE /dev/zram0 2>/dev/null | tr -d ' ') ($(cat /sys/block/zram0/comp_algorithm 2>/dev/null | grep -o '\[[a-z0-9-]*\]' | tr -d '[]'))"
  else
    off "zram swap" "off"
  fi
  local d s
  for d in /sys/block/{nvme,sd,vd}*; do
    [[ -e $d/queue/scheduler ]] || continue
    s=$(grep -o '\[[a-z-]*\]' "$d/queue/scheduler" | tr -d '[]')
    ok "I/O ${d##*/}" "$s"
  done
  if [[ -e /dev/ntsync ]]; then ok "NTSYNC (Wine/Proton)" "available"; else off "NTSYNC (Wine/Proton)" "not loaded"; fi
  if [[ "$(sysctl -n kernel.split_lock_mitigate 2>/dev/null || echo 1)" == 0 ]]; then
    ok "Split-lock penalty" "off (better for some games)"
  else
    off "Split-lock penalty" "on"
  fi
  if systemctl is-enabled -q reflector.timer 2>/dev/null; then ok "Mirror ranking" "weekly"; else off "Mirror ranking" "manual"; fi
  echo
}

# --- sched-ext CPU schedulers ----------------------------------------------------------
# Schedulers from the scx project run as BPF programs and can be switched live,
# with no reboot. bpfland favours interactive apps, lavd is tuned for gaming
# (Steam Deck), rusty for throughput, flash for latency.
scheduler() {
  local name="${1:-}"
  case "$name" in
    bpfland | lavd | rusty | flash) ;;
    off | none | default) name=off ;;
    "") name=$(printf '%s\n' \
      "bpfland   desktop responsiveness (recommended)" \
      "lavd      gaming, low latency" \
      "rusty     heavy workloads, throughput" \
      "flash     audio and latency-critical work" \
      "off       the kernel's default (EEVDF)" |
      fzf --height=~10 --prompt 'CPU scheduler ❯ ' | awk '{print $1}') || exit 0 ;;
    *) die "Schedulers: bpfland, lavd, rusty, flash, off" ;;
  esac
  [[ -n "$name" ]] || exit 0
  [[ -d /sys/kernel/sched_ext ]] || die "This kernel has no sched-ext support (needs Linux 6.12+)."

  if [[ "$name" == off ]]; then
    sudo systemctl disable --now scx_loader.service scx.service 2>/dev/null || true
    say "CPU scheduler: default"
    return
  fi

  pacman -Q "${PKGS_TUNE_SCX[@]}" >/dev/null 2>&1 || add "${PKGS_TUNE_SCX[@]}"
  # Newer scx releases split the loader into scx-tools.
  if ! has scxctl && pacman -Si scx-tools >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm scx-tools
  fi

  if systemctl cat scx_loader.service >/dev/null 2>&1; then
    printf 'default_sched = "scx_%s"\ndefault_mode = "Auto"\n' "$name" | sudo tee /etc/scx_loader.toml >/dev/null
    sudo systemctl enable scx_loader.service
    sudo systemctl restart scx_loader.service
  elif systemctl cat scx.service >/dev/null 2>&1; then
    printf 'SCX_SCHEDULER=scx_%s\nSCX_FLAGS=\n' "$name" | sudo tee /etc/default/scx >/dev/null
    sudo systemctl enable scx.service
    sudo systemctl restart scx.service
  else
    die "Couldn't find the scx service after installing ${PKGS_TUNE_SCX[*]}."
  fi
  sleep 1
  say "CPU scheduler: $(current_scheduler)"
  echo "  It starts with every boot. Switch back with: anarch tune scheduler off"
}

# --- Kernels ---------------------------------------------------------------------------
# kernel NAME — add the zen, hardened, lts or latest kernel as a boot entry;
# kernel remove-NAME — take it away again.
kernel() {
  local entries=/boot/loader/entries loader=/boot/loader/loader.conf arg="${1:-}" name pkg main label
  # Installed alongside Windows, the boot menu's settings are on Windows' EFI partition.
  [[ -f /efi/loader/loader.conf ]] && loader=/efi/loader/loader.conf
  name=${arg#remove-}
  case "$name" in
    zen | hardened | lts) pkg="linux-$name" ;;
    linux | latest) name=linux pkg=linux ;;
    *) die "usage: anarch-tune kernel zen|hardened|lts|linux  (or remove-zen, remove-hardened, …)" ;;
  esac
  case "$name" in lts) label="LTS kernel" ;; linux) label="standard kernel" ;; *) label="$name kernel" ;; esac
  main=$(sed -n 's#^linux[[:space:]]*/vmlinuz-##p' "$entries/lumen.conf" 2>/dev/null)
  if [[ "$arg" == remove-* ]]; then
    [[ "$main" == "$pkg" ]] && die "The $label is the main one in the boot menu; it can't be removed."
    [[ "$(uname -r)" == *"-$name"* || ( $name == linux && "$(uname -r)" == *-arch* ) ]] &&
      die "You're running the $label right now. Restart into another kernel first."
    sudo sed -i "s/^default lumen-$name.conf/default lumen.conf/" "$loader" 2>/dev/null || true
    sudo rm -f "$entries/lumen-$name.conf"
    sudo pacman -Rns --noconfirm "$pkg" "$pkg-headers" 2>/dev/null || sudo pacman -Rns --noconfirm "$pkg"
    say "$label removed"
    return
  fi
  [[ "$main" == "$pkg" ]] && { say "The $label is already the main one in the boot menu."; return; }
  add "$pkg"
  # NVIDIA's driver is built for each kernel: it needs the kernel's headers.
  pacman -Qq nvidia-open-dkms >/dev/null 2>&1 && add "$pkg-headers"
  if [[ -f $entries/lumen.conf && -n "$main" ]]; then
    sudo sed -e "s/^title .*/title   an4rch OS ($label)/" \
      -e "s#/vmlinuz-$main\$#/vmlinuz-$pkg#" \
      -e "s#/initramfs-$main\\.img\$#/initramfs-$pkg.img#" \
      "$entries/lumen.conf" | sudo tee "$entries/lumen-$name.conf" >/dev/null
    say "Added \"an4rch OS ($label)\" to the boot menu"
    printf '  Make it the default? [y/N] '
    read -r yn
    if [[ "$yn" == [yY]* ]]; then
      sudo sed -i "s/^default .*/default lumen-$name.conf/" "$loader"
      echo "  Done. The other kernels stay in the boot menu as fallbacks."
    fi
  else
    say "$pkg installed"
    echo "  Add a boot entry for /vmlinuz-$pkg in your boot loader to use it."
  fi
}

# --- Mirrors ---------------------------------------------------------------------------
mirrors() {
  add "${PKGS_TUNE_MIRRORS[@]}"
  say "Ranking mirrors (about a minute)"
  sudo install -d /etc/xdg/reflector
  sudo tee /etc/xdg/reflector/reflector.conf >/dev/null <<'EOF'
# an4rch: the 20 fastest recently-synced HTTPS mirrors, re-ranked weekly.
--save /etc/pacman.d/mirrorlist
--protocol https
--latest 20
--sort rate
EOF
  sudo cp /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
  if sudo systemctl start reflector.service; then
    sudo systemctl enable reflector.timer >/dev/null 2>&1
    head -n 15 /etc/pacman.d/mirrorlist | grep '^Server' || true
    say "Mirrors ranked; they're re-ranked every week"
  else
    sudo cp /etc/pacman.d/mirrorlist.bak /etc/pacman.d/mirrorlist
    die "Ranking failed (offline?). Your previous mirror list is back."
  fi
}

pick() {
  case $(printf '%s\n' \
    "󰓅  Status" \
    "󰍛  CPU scheduler (sched-ext)" \
    "󰌢  Add the zen kernel" \
    "󰒍  Rank mirrors by speed" |
    menu "Performance" --width 34 --lines 4) in
    *Status) term --float --hold --title "Performance" -- "$0" status ;;
    *scheduler*) "$0" scheduler ;;
    *zen*) "$0" kernel zen ;;
    *mirrors*) "$0" mirrors ;;
  esac
}

case "${1:-pick}" in
  pick) pick ;;
  status) status ;;
  scheduler) scheduler "${2:-}" ;;
  kernel) kernel "${2:-}" ;;
  mirrors) mirrors ;;
  -h | --help | help) sed -n '2,13s/^# \{0,1\}//p' "$0" ;;
  *) die "Unknown command '$1'. See: anarch-tune --help" ;;
esac
