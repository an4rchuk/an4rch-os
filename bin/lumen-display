#!/usr/bin/env bash
# lumen-display — obsolete name (before An4rch OS 1.1.0) of anarch-display; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-display is obsolete: use anarch-display (or: anarch display)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-display" "$@"
