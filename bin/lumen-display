#!/usr/bin/env bash
# lumen-display — arrange displays: resolution, scale, position, mirroring (SUPER + ALT + D).
#
# Changes are written to ~/.config/hypr/monitors.lua and applied at once. If
# you don't confirm within 15 seconds, the previous layout comes back — so a
# bad mode can never leave you with a black screen.
#
#   lumen-display            interactive menu
#   lumen-display save       write the current live layout to monitors.lua
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

conf="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/monitors.lua"
state=$(hyprctl monitors all -j)

# --- state → monitors.lua -------------------------------------------------------
# Every display is keyed by its description (make, model, serial) so the layout
# follows the screen, not the port it happens to be plugged into.
render() {
  jq -r '
    def fmt: if . == (. | floor) then tostring else (. * 1000 | round / 1000 | tostring) end;
    def target: if (.description // "") != "" then "desc:" + .description else .name end;
    "-- Displays — written by lumen-display on \(now | strftime("%Y-%m-%d %H:%M")).",
    "-- Edit freely, or run `lumen-display` (SUPER + ALT + D) again.",
    "",
    (.[] |
      if .disabled then
        "hl.monitor({ output = \"\(target)\", disabled = true })"
      elif (.mirrorOf // "none") != "none" then
        "hl.monitor({ output = \"\(target)\", mode = \"preferred\", position = \"auto\", scale = \"auto\", mirror = \"\(.mirrorOf)\" })"
      elif (.width // 0) == 0 then
        "hl.monitor({ output = \"\(target)\", mode = \"preferred\", position = \"auto\", scale = \"auto\" })"
      else
        "hl.monitor({ output = \"\(target)\", mode = \"\(.width)x\(.height)@\(.refreshRate | . * 100 | round / 100 | tostring)\", position = \"\(.x)x\(.y)\", scale = \(.scale | fmt), transform = \(.transform) })"
      end),
    "",
    "-- Displays plugged in later: best mode, placed to the right.",
    "hl.monitor({ output = \"\", mode = \"preferred\", position = \"auto\", scale = \"auto\" })"
  ' <<<"$1"
}

# Logical size of a monitor (after scale and rotation), for placing neighbours.
logical() { # logical JSON NAME → "W H X Y"
  jq -r --arg n "$2" '.[] | select(.name == $n) |
    (if (.transform % 2) == 1 then [.height, .width] else [.width, .height] end) as [$w, $h] |
    "\($w / .scale | round) \($h / .scale | round) \(.x) \(.y)"' <<<"$1"
}

apply() { # apply NEW_JSON
  local new="$1" backup="$conf.bak"
  mkdir -p "$(dirname "$conf")"
  [[ -f "$conf" ]] && cp "$conf" "$backup"
  render "$new" >"$conf"
  hyprctl reload >/dev/null
  sleep 1
  if timeout 15 bash -c "printf '  Keep these settings\n  Revert\n' | fuzzel --dmenu --prompt 'Keep display settings? (reverts in 15s)  ' --lines 2 --width 40" | grep -q Keep; then
    notify "Display settings saved" "${conf/#$HOME/\~}" -i video-display
  else
    if [[ -f "$backup" ]]; then cp "$backup" "$conf"; else rm -f "$conf"; fi
    hyprctl reload >/dev/null
    notify "Display settings reverted" "" -i video-display
  fi
}

set_field() { # set_field NAME JQ_ASSIGNMENT
  jq --arg n "$1" "map(if .name == \$n then $2 else . end)" <<<"$state"
}

monitor_menu() {
  local name="$1" desc
  desc=$(jq -r --arg n "$name" '.[] | select(.name == $n) | "\(.description) — \(.width)x\(.height)@\(.refreshRate | floor)Hz ×\(.scale)"' <<<"$state")
  local others
  mapfile -t others < <(jq -r --arg n "$name" '.[] | select(.name != $n and (.disabled | not)) | .name' <<<"$state")

  local -a items=("󰍹  Resolution and refresh rate" "󰁌  Scale" "󰑵  Rotate")
  [[ ${#others[@]} -gt 0 ]] && items+=("󰍺  Position" "󰍺  Mirror another display")
  if jq -e --arg n "$name" '.[] | select(.name == $n) | .disabled' <<<"$state" >/dev/null; then
    items+=("󰶐  Turn on")
  elif [[ ${#others[@]} -gt 0 ]]; then
    items+=("󰶐  Turn off")
  fi

  local choice
  choice=$(printf '%s\n' "${items[@]}" | menu "$name" --width 46 --lines "${#items[@]}" --placeholder "$desc") || exit 0

  case "$choice" in
    *Resolution*)
      local modes mode w h r
      mapfile -t modes < <(jq -r --arg n "$name" '.[] | select(.name == $n) | .availableModes[]' <<<"$state" | awk '!seen[$0]++')
      mode=$(printf '%s\n' "${modes[@]}" | menu "Mode" --width 30 --lines 12) || exit 0
      [[ "$mode" =~ ^([0-9]+)x([0-9]+)@([0-9.]+)Hz$ ]] || die "Unexpected mode '$mode'"
      w="${BASH_REMATCH[1]}" h="${BASH_REMATCH[2]}" r="${BASH_REMATCH[3]}"
      apply "$(set_field "$name" ".width = $w | .height = $h | .refreshRate = $r")"
      ;;
    *Scale*)
      local s
      s=$(printf '%s\n' 1 1.25 1.333333 1.5 1.666667 2 2.5 3 | menu "Scale" --width 24 --lines 8) || exit 0
      apply "$(set_field "$name" ".scale = $s")"
      ;;
    *Rotate*)
      local rot t
      rot=$(printf '%s\n' "Normal" "90° clockwise" "Upside down" "90° counter-clockwise" | menu "Rotate" --index --width 30 --lines 4) || exit 0
      t=$((rot == 1 ? 3 : rot == 3 ? 1 : rot))
      apply "$(set_field "$name" ".transform = $t")"
      ;;
    *Position*)
      local other where ow oh ox oy mw mh x y
      other=$(printf '%s\n' "${others[@]}" | menu "Next to" --width 30 --lines "${#others[@]}") || exit 0
      where=$(printf '%s\n' "Right of $other" "Left of $other" "Above $other" "Below $other" | menu "Place" --index --width 30 --lines 4) || exit 0
      read -r ow oh ox oy < <(logical "$state" "$other")
      read -r mw mh _ _ < <(logical "$state" "$name")
      case "$where" in
        0) x=$((ox + ow)) y=$oy ;;
        1) x=$((ox - mw)) y=$oy ;;
        2) x=$ox y=$((oy - mh)) ;;
        3) x=$ox y=$((oy + oh)) ;;
      esac
      apply "$(set_field "$name" ".x = $x | .y = $y | .mirrorOf = \"none\"")"
      ;;
    *Mirror*)
      local other
      other=$(printf '%s\n' "${others[@]}" | menu "Mirror" --width 30 --lines "${#others[@]}") || exit 0
      apply "$(set_field "$name" ".mirrorOf = \"$other\"")"
      ;;
    *"Turn off"*) apply "$(set_field "$name" ".disabled = true")" ;;
    *"Turn on"*) apply "$(set_field "$name" ".disabled = false | .mirrorOf = \"none\"")" ;;
  esac
}

presets() {
  local internal external
  internal=$(jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)"))][0].name // empty' <<<"$state")
  external=$(jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)") | not)][0].name // empty' <<<"$state")
  [[ -n "$internal" && -n "$external" ]] || return 1
  printf '%s\n' "󰍺  Extend: $external right of $internal" "󰍹  Only $external (laptop screen off)" "󰌢  Only $internal" "󰍺  Mirror $internal on $external"
}

case "${1:-}" in
  save)
    mkdir -p "$(dirname "$conf")"
    render "$state" >"$conf"
    echo "Saved ${conf/#$HOME/\~}"
    exit 0
    ;;
  -h | --help | help) sed -n '2,9s/^# \{0,1\}//p' "$0"; exit 0 ;;
esac

mapfile -t names < <(jq -r '.[].name' <<<"$state")
mapfile -t labels < <(jq -r '.[] | (if .disabled then "󰶐" else "󰍹" end) + "  \(.name)  ·  \(.description | .[0:38])  ·  " + (if .disabled then "off" else "\(.width)x\(.height) ×\(.scale)" end)' <<<"$state")
mapfile -t preset_items < <(presets || true)

choice=$( { printf '%s\n' "${labels[@]}"; [[ ${#preset_items[@]} -gt 0 ]] && printf '%s\n' "${preset_items[@]}"; printf '%s\n' "󰑓  Detect displays again"; } |
  menu "Displays" --index --width 64 --lines $((${#labels[@]} + ${#preset_items[@]} + 1))) || exit 0

if ((choice < ${#names[@]})); then
  monitor_menu "${names[$choice]}"
  exit 0
fi

choice=$((choice - ${#names[@]}))
if ((choice < ${#preset_items[@]})); then
  internal=$(jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)"))][0].name' <<<"$state")
  external=$(jq -r '[.[] | select(.name | test("^(eDP|LVDS|DSI)") | not)][0].name' <<<"$state")
  read -r iw _ _ _ < <(logical "$state" "$internal")
  case "$choice" in
    0) new=$(jq --arg i "$internal" --arg e "$external" --argjson iw "$iw" 'map(
         if .name == $i then .x = 0 | .y = 0 | .disabled = false | .mirrorOf = "none"
         elif .name == $e then .x = $iw | .y = 0 | .disabled = false | .mirrorOf = "none" else . end)' <<<"$state") ;;
    1) new=$(jq --arg i "$internal" --arg e "$external" 'map(
         if .name == $i then .disabled = true elif .name == $e then .disabled = false | .mirrorOf = "none" | .x = 0 | .y = 0 else . end)' <<<"$state") ;;
    2) new=$(jq --arg i "$internal" --arg e "$external" 'map(
         if .name == $e then .disabled = true elif .name == $i then .disabled = false | .x = 0 | .y = 0 else . end)' <<<"$state") ;;
    3) new=$(jq --arg i "$internal" --arg e "$external" 'map(
         if .name == $e then .mirrorOf = $i | .disabled = false elif .name == $i then .disabled = false else . end)' <<<"$state") ;;
  esac
  apply "$new"
else
  hyprctl reload >/dev/null
  notify "Displays refreshed" "" -i video-display
fi
