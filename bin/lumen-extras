#!/usr/bin/env bash
# lumen-extras — obsolete name (before An4rch OS 1.1.0) of anarch-extras; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-extras is obsolete: use anarch-extras (or: anarch extras)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-extras" "$@"
