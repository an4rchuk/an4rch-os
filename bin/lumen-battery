#!/usr/bin/env bash
# lumen-battery — obsolete name (before an4rch OS 1.1.0) of anarch-battery; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-battery is obsolete: use anarch-battery (or: anarch battery)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-battery" "$@"
