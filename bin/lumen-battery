#!/usr/bin/env bash
# lumen-battery — battery level and low-battery warnings.
#
#   lumen-battery            print the charge, e.g. "84% Discharging"
#   lumen-battery watch      warn at 20% and 10%, then suspend at 4% (started with the session)
#
# Thresholds can be changed in ~/.config/lumen/settings.conf:
#   LUMEN_BATTERY_LOW=20  LUMEN_BATTERY_CRITICAL=10  LUMEN_BATTERY_SUSPEND=4  (0 turns suspend off)
set -uo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

LOW=${LUMEN_BATTERY_LOW:-20}
CRITICAL=${LUMEN_BATTERY_CRITICAL:-10}
SUSPEND=${LUMEN_BATTERY_SUSPEND:-4}

battery() {
  local b
  for b in /sys/class/power_supply/BAT*; do
    [[ -r $b/capacity ]] && { echo "$b"; return 0; }
  done
  return 1
}

level() {
  local b
  b=$(battery) || { echo "No battery"; return 1; }
  echo "$(cat "$b/capacity")% $(cat "$b/status")"
}

watch() {
  local b cap status warned=100
  b=$(battery) || exit 0 # desktops: nothing to watch
  while sleep 60; do
    cap=$(cat "$b/capacity" 2>/dev/null) || continue
    status=$(cat "$b/status" 2>/dev/null)
    if [[ "$status" != Discharging ]]; then
      warned=100
      continue
    fi
    if ((SUSPEND > 0 && cap <= SUSPEND)); then
      notify "Battery empty" "Suspending now to keep your work safe." -u critical -i battery-empty
      sleep 10
      [[ "$(cat "$b/status")" == Discharging ]] && systemctl suspend
    elif ((cap <= CRITICAL && warned > CRITICAL)); then
      warned=$CRITICAL
      notify "Battery critical: $cap%" "Plug in now. The computer suspends at $SUSPEND%." -u critical -i battery-caution
    elif ((cap <= LOW && warned > LOW)); then
      warned=$LOW
      notify "Battery low: $cap%" "Consider plugging in, or switch to the power saver profile." -i battery-low
    fi
  done
}

case "${1:-level}" in
  level) level ;;
  watch) watch ;;
  -h | --help | help) sed -n '2,8s/^# \{0,1\}//p' "$0" ;;
  *) die "Unknown command '$1'. See: lumen-battery --help" ;;
esac
