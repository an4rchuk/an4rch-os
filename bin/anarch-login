#!/usr/bin/env bash
# anarch-login — the login screen: the an4rch logo (where the boot screen
# leaves it) and your theme's colours.
#
#   anarch-login sync      copy the current theme (and wallpaper) to the login screen
#                         (done automatically when either changes)
#   anarch-login wallpaper on|off   your desktop wallpaper behind the login
#                         instead of the logo (or not)
#   anarch-login preview   show the login screen in a window
#   anarch-login setup     install the graphical login screen (asks for your password)
#   anarch-login text on|off   use the plain text login screen instead (or not)
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

DIR=/var/lib/lumen/login

sync() {
  [[ -d "$DIR" && -w "$DIR" ]] || return 0
  local t="$LUMEN_CURRENT/theme" wall="$LUMEN_CURRENT/wallpaper"
  local logo=1
  [[ -e "$DIR/use-wallpaper" ]] && logo=0
  # The logo background, drawn for this screen (the boot screen ends on the
  # same picture). Without Python's imaging library, the wallpaper instead.
  if ((logo)) && ! python3 "$LUMEN_PATH/share/greeter/login-background" --size "$(screen_size)" --out "$DIR/wallpaper" 2>/dev/null; then
    logo=0
  fi
  if ((!logo)) && [[ -e "$wall" ]]; then
    cp -L "$wall" "$DIR/wallpaper.new" && chmod 644 "$DIR/wallpaper.new" && mv -f "$DIR/wallpaper.new" "$DIR/wallpaper"
  fi
  if [[ -f "$t/greeter.css" ]]; then
    install -m644 "$t/greeter.css" "$DIR/greeter.css.new" && mv -f "$DIR/greeter.css.new" "$DIR/greeter.css"
  fi
  if [[ -f "$t/regreet.css" ]]; then
    {
      cat "$t/regreet.css"
      # Room for the logo: the login box sits below it.
      if ((logo)); then printf '\n/* The login form sits below the an4rch logo; the clock stays at the top (anarch-login). */\noverlay > frame:nth-child(2) { margin-top: 300px; }\n'; fi
    } >"$DIR/regreet.css.new" && chmod 644 "$DIR/regreet.css.new" && mv -f "$DIR/regreet.css.new" "$DIR/regreet.css"
  fi
  local LUMEN_THEME_MODE="dark" LUMEN_THEME_ICONS="Papirus-Dark"
  # shellcheck source=/dev/null
  if [[ -f "$t/theme.env" ]]; then source "$t/theme.env"; fi
  local dark=true
  if [[ "$LUMEN_THEME_MODE" == light ]]; then dark=false; fi
  cat >"$DIR/regreet.toml" <<TOML
# Written by anarch-login sync: change the theme or wallpaper instead.
[background]
path = "$DIR/wallpaper"
fit = "Cover"

[GTK]
application_prefer_dark_theme = $dark
icon_theme_name = "$LUMEN_THEME_ICONS"
font_name = "Inter 12"

[commands]
reboot = ["systemctl", "reboot"]
poweroff = ["systemctl", "poweroff"]

[appearance]
greeting_msg = "Welcome back"
TOML
}

# The largest screen's size (the login screen draws its background for it).
screen_size() {
  local s=""
  if has hyprctl && has jq; then
    s=$(hyprctl monitors -j 2>/dev/null | jq -r 'max_by(.width * .height) | "\(.width)x\(.height)"' 2>/dev/null || true)
  fi
  # No desktop yet (while installing): the connected screens' preferred modes.
  if [[ ! "$s" =~ ^[0-9]{3,5}x[0-9]{3,5}$ ]]; then
    local c
    for c in /sys/class/drm/card*-*; do
      [[ "$(cat "$c/status" 2>/dev/null)" == connected ]] || continue
      s=$(head -n1 "$c/modes" 2>/dev/null)
      [[ "$s" =~ ^[0-9]{3,5}x[0-9]{3,5}$ ]] && break
    done
  fi
  [[ "$s" =~ ^[0-9]{3,5}x[0-9]{3,5}$ ]] && echo "$s" || echo 1920x1080
}

# The login screen app, where the greeter user can read it (not in your home).
install_app() {
  sudo install -d /usr/local/share/lumen/greeter
  sudo install -m644 "$LUMEN_PATH"/apps/lumen-greeter/*.py "$LUMEN_PATH"/apps/lumen-greeter/*.css /usr/local/share/lumen/greeter/
}

setup() {
  local pkgs=() p
  for p in greetd greetd-regreet greetd-tuigreet cage; do pacman -Q "$p" >/dev/null 2>&1 || pkgs+=("$p"); done
  ((${#pkgs[@]} == 0)) || sudo pacman -S --needed --noconfirm "${pkgs[@]}"
  sudo install -D -m755 "$LUMEN_PATH/share/greeter/lumen-greeter" /usr/local/bin/lumen-greeter
  install_app
  # Undo-the-last-update from the login screen (when the desktop won't start).
  sudo install -Dm755 "$LUMEN_PATH/share/recover/lumen-recover" /usr/local/lib/lumen/lumen-recover
  sudo install -Dm644 -t /etc/systemd/system "$LUMEN_PATH/share/recover/lumen-recover.path" "$LUMEN_PATH/share/recover/lumen-recover.service"
  sudo systemctl daemon-reload
  sudo systemctl enable lumen-recover.path >/dev/null 2>&1 || true
  # Where the login screen remembers who logged in last.
  sudo install -d -m755 -o greeter -g greeter /var/cache/lumen-greeter 2>/dev/null || sudo install -d -m777 /var/cache/lumen-greeter
  sudo install -D -m644 -t /usr/local/share/lumen/wayland-sessions "$LUMEN_PATH"/share/greeter/wayland-sessions/*.desktop
  sudo rm -rf /usr/local/share/lumen/sessions
  sudo install -d -m755 -o "$(id -un)" -g "$(id -gn)" "$DIR"

  # Keep auto-login ([initial_session]) if it's set.
  local conf=/etc/greetd/config.toml initial=""
  if [[ -f "$conf" ]]; then initial=$(sed -n '/^\[initial_session\]/,$p' "$conf"); fi
  sudo mkdir -p /etc/greetd
  {
    printf '# an4rch login screen: greetd runs lumen-greeter (ReGreet, or tuigreet as a fallback).\n'
    printf '[terminal]\nvt = 1\n\n[default_session]\ncommand = "/usr/local/bin/lumen-greeter"\nuser = "greeter"\n'
    if [[ -n "$initial" ]]; then printf '\n%s\n' "$initial"; fi
  } | sudo tee "$conf" >/dev/null
  sync
}

case "${1:-sync}" in
  sync) sync ;;
  setup) setup ;;
  preview)
    sync
    LUMEN_LOGIN_DIR="$DIR" LUMEN_GREETER_CACHE="${XDG_RUNTIME_DIR:-/tmp}/greeter-preview" \
      XDG_DATA_DIRS="/usr/local/share/lumen:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" \
      launch python3 "$LUMEN_PATH/apps/lumen-greeter/lumen_greeter.py" --demo
    ;;
  update-app) install_app ;;
  wallpaper)
    case "${2:-}" in
      on) touch "$DIR/use-wallpaper" && sync && echo "✓ The login screen shows your wallpaper." ;;
      off) rm -f "$DIR/use-wallpaper" && sync && echo "✓ The login screen shows the an4rch logo." ;;
      *) die "usage: anarch-login wallpaper on|off" ;;
    esac
    ;;
  text)
    case "${2:-}" in
      on) touch "$DIR/text-only" && echo "The next login uses the text login screen." ;;
      off) rm -f "$DIR/text-only" && echo "The next login uses the graphical login screen." ;;
      *) die "usage: anarch-login text on|off" ;;
    esac
    ;;
  -h | --help | help) sed -n '2,11s/^# \{0,1\}//p' "$0" ;;
  *) die "Unknown command '$1'. See: anarch-login --help" ;;
esac
