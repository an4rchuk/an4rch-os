#!/usr/bin/env bash
# lumen-toggle — obsolete name (before an4rch OS 1.1.0) of anarch-toggle; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-toggle is obsolete: use anarch-toggle (or: anarch toggle)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-toggle" "$@"
