#!/usr/bin/env bash
# lumen-titlebars — title bars with close, maximise and minimise buttons on every window.
#
#   lumen-titlebars on       turn them on (builds the plugin the first time, a few minutes)
#   lumen-titlebars off      turn them off: a clean, borderless tiling look
#   lumen-titlebars toggle   switch between the two
#   lumen-titlebars status   show whether they're on and the plugin is loaded
#   lumen-titlebars setup    (re)build the plugin, e.g. after a Hyprland update
#   lumen-titlebars load     load the plugin into the running session (used at login)
#
# The bars come from hyprbars, Hyprland's official plugin, built for your
# exact Hyprland version by hyprpm. Their colours follow your theme.
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"
source "$LUMEN_PATH/install/packages.sh"

REPO=https://github.com/hyprwm/hyprland-plugins

in_session() { [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; }
built() { hyprpm list 2>/dev/null | grep -q hyprbars; }

setup() {
  local missing=() p
  for p in "${PKGS_TITLEBARS[@]}"; do pacman -Q "$p" >/dev/null 2>&1 || missing+=("$p"); done
  if ((${#missing[@]})); then
    echo "Installing build tools: ${missing[*]}"
    sudo pacman -S --needed --noconfirm "${missing[@]}"
  fi
  echo "Fetching Hyprland's headers for your version (one-time, a few minutes)…"
  hyprpm update
  if ! hyprpm list 2>/dev/null | grep -q 'hyprland-plugins'; then
    yes | hyprpm add "$REPO"
  fi
  hyprpm enable hyprbars
}

set_setting() {
  mkdir -p "$LUMEN_CONFIG"
  local f="$LUMEN_CONFIG/settings.conf"
  touch "$f"
  if grep -q '^LUMEN_TITLEBARS=' "$f"; then
    sed -i "s/^LUMEN_TITLEBARS=.*/LUMEN_TITLEBARS=$1/" "$f"
  else
    printf '\n# Title bars with window buttons: yes | no\nLUMEN_TITLEBARS=%s\n' "$1" >>"$f"
  fi
}

load() {
  [[ "${LUMEN_TITLEBARS:-yes}" == yes ]] || return 0
  in_session || return 0
  built || return 0
  hyprpm reload -nn >/dev/null 2>&1 || true
}

on() {
  set_setting yes
  built || setup
  hyprpm enable hyprbars >/dev/null 2>&1 || true
  if in_session; then hyprpm reload -n >/dev/null 2>&1 || true; fi
  notify "Title bars on" "Close, maximise and minimise buttons on every window" -i window-new
}

off() {
  set_setting no
  hyprpm disable hyprbars >/dev/null 2>&1 || true
  if in_session; then hyprpm reload >/dev/null 2>&1 || true; fi
  notify "Title bars off" "Windows tile edge to edge" -i window-new
}

status() {
  echo "Setting:  LUMEN_TITLEBARS=${LUMEN_TITLEBARS:-yes}"
  if built; then echo "Plugin:   built"; else echo "Plugin:   not built (lumen-titlebars setup)"; fi
  if in_session && hyprctl plugin list 2>/dev/null | grep -q hyprbars; then echo "Session:  loaded"; else echo "Session:  not loaded"; fi
}

# Building takes a while: from a key binding or menu, show it in a terminal.
case "${1:-toggle}" in
  on | setup | toggle)
    if [[ ! -t 0 && -z "${LUMEN_YES:-}" ]] && in_session && ! built; then
      term --float --hold --title "Title bars" -- "$0" "$@"
      exit 0
    fi
    ;;
esac

case "${1:-toggle}" in
  on) on ;;
  off) off ;;
  toggle) if [[ "${LUMEN_TITLEBARS:-yes}" == yes ]] && built; then off; else on; fi ;;
  status) status ;;
  setup) setup ;;
  load) load ;;
  -h | --help | help) sed -n '2,13s/^# \{0,1\}//p' "$0" ;;
  *) die "Unknown command '$1'. See: lumen-titlebars --help" ;;
esac
