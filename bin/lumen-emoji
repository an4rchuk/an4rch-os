#!/usr/bin/env bash
# lumen-emoji — search emoji and symbols by name, copy the one you pick.
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

list="$LUMEN_CACHE/emoji.tsv"
recent="$LUMEN_STATE/emoji-recent"
mkdir -p "$LUMEN_CACHE" "$LUMEN_STATE"

# Build the list once from Python's Unicode database: no extra packages.
if [[ ! -s "$list" ]]; then
  python3 - "$list" <<'PY'
import sys, unicodedata
ranges = [(0x1F300, 0x1F5FF), (0x1F600, 0x1F64F), (0x1F680, 0x1F6FF), (0x1F900, 0x1F9FF),
          (0x1FA70, 0x1FAFF), (0x2600, 0x26FF), (0x2700, 0x27BF), (0x2190, 0x21FF),
          (0x2300, 0x23FF), (0x25A0, 0x25FF), (0x2B00, 0x2BFF), (0x1F100, 0x1F1FF)]
with open(sys.argv[1], "w") as f:
    for lo, hi in ranges:
        for cp in range(lo, hi + 1):
            ch = chr(cp)
            name = unicodedata.name(ch, "")
            if name:
                f.write(f"{ch}\t{ch}  {name.lower()}\n")
PY
fi

choice=$( { [[ -f "$recent" ]] && cat "$recent"; cat "$list"; } | awk -F'\t' '!seen[$1]++' |
  menu "Emoji" --with-nth 2 --width 46 --lines 12) || exit 0
emoji="${choice%%$'\t'*}"
[[ -n "$emoji" ]] || exit 0
printf '%s' "$emoji" | wl-copy
# Most recently used float to the top next time.
{ printf '%s\n' "$choice"; grep -vF -- "$choice" "$recent" 2>/dev/null | head -n 23; } >"$recent.tmp" && mv "$recent.tmp" "$recent"
notify "$emoji  copied" "" -t 1500 -h string:x-canonical-private-synchronous:lumen-emoji
