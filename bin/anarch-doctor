#!/usr/bin/env bash
# anarch-doctor — check that everything an4rch needs is installed and running.
#
#   anarch-doctor            full report
#   anarch-doctor windows    print class and title of open windows (for rules)
#   anarch-doctor hardware   laptop model, graphics, Wi-Fi/Bluetooth chips and
#                           drivers, firmware errors (saved to a file to share)
set -uo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

if [[ "${1:-}" == windows ]]; then
  hyprctl clients -j | jq -r '.[] | "\(.class)\t\(.title)"' | column -t -s $'\t'
  exit 0
fi

if [[ "${1:-}" == hardware ]]; then
  out="$HOME/lumen-hardware-report.txt"
  dmi() { cat "/sys/class/dmi/id/$1" 2>/dev/null || echo "?"; }
  # PCI devices of a class, with the driver in use ("Kernel driver in use").
  pci() { lspci -nnk 2>/dev/null | awk -v re="$1" '
      /^[0-9a-f]/ { show = ($0 ~ re); if (show) print "  " substr($0, 9); next }
      show && /Kernel driver in use/ { sub(/^[ \t]+/, ""); print "    " $0 }'; }
  {
    echo "an4rch hardware report  $(date '+%F %R')  an4rch $(cat "$LUMEN_PATH/VERSION" 2>/dev/null || echo dev)"
    echo "Computer: $(dmi sys_vendor) $(dmi product_name) $(dmi product_version)  (BIOS $(dmi bios_version))"
    echo "CPU: $(grep -m1 'model name' /proc/cpuinfo 2>/dev/null | cut -d: -f2- | sed 's/^ *//')"
    echo "Memory: $(free -h 2>/dev/null | awk '/^Mem:/ {print $2}')  Kernel: $(uname -r)"
    if [[ -d /sys/firmware/efi ]]; then
      sb=$(od -An -t u1 -j4 -N1 /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | tr -d ' ')
      echo "Boot: UEFI, Secure Boot $([[ "$sb" == 1 ]] && echo ON || echo off)"
    else
      echo "Boot: legacy BIOS"
    fi
    echo "Graphics:"; pci 'VGA|3D|Display'
    echo "Network:"; pci 'Network|Ethernet'
    if has lsusb; then
      bt=$(lsusb 2>/dev/null | grep -i -E 'bluetooth|wireless|802\.11|wlan' || true)
      [[ -n "$bt" ]] && { echo "USB wireless/Bluetooth:"; sed 's/^/  /' <<<"$bt"; }
    fi
    echo "Wi-Fi/Bluetooth switches:"; rfkill list 2>/dev/null | sed 's/^/  /' || echo "  (rfkill not available)"
    echo "Devices:"; nmcli -t -f DEVICE,TYPE,STATE dev 2>/dev/null | sed 's/^/  /'
    has bluetoothctl && echo "Bluetooth: $(timeout 3 bluetoothctl show 2>/dev/null | grep -m1 -E 'Powered' | sed 's/^\s*//' || echo 'no controller found')"
    echo "Firmware/driver errors this boot:"
    errs=$( (journalctl -k -b --no-pager -q 2>/dev/null || dmesg 2>/dev/null) |
      grep -i -E 'firmware.*(fail|missing|not found|error)|direct firmware load|failed to load|iwlwifi.*error|ath1[01]k.*fail|rtw.*fail|bluetooth.*(fail|timeout|error)|amdgpu.*error|i915.*error|nouveau.*(fail|error)' |
      tail -n 25)
    if [[ -n "$errs" ]]; then sed 's/^/  /' <<<"$errs"; else echo "  none"; fi
    applog="${XDG_STATE_HOME:-$HOME/.local/state}/lumen/apps.log"
    if [[ -s "$applog" ]]; then echo "Apps that couldn't start:"; tail -n 8 "$applog" | cut -c1-200 | sed 's/^/  /'; fi
  } | tee "$out"
  printf '\nSaved to %s (photograph this screen or send the file).\n' "$out"
  exit 0
fi

ok=0 warn=0 bad=0
pass() { printf '  \e[32m✓\e[0m %s\n' "$1"; ok=$((ok + 1)); }
note() { printf '  \e[33m!\e[0m %s\n' "$1"; warn=$((warn + 1)); }
fail() { printf '  \e[31m✗\e[0m %s\n' "$1"; bad=$((bad + 1)); }
section() { printf '\n\e[1m%s\e[0m\n' "$1"; }

need() { # need CMD [package] [optional]
  if has "$1"; then pass "$1"; elif [[ "${3:-}" == optional ]]; then note "$1 not installed (optional: anarch-pkg add ${2:-$1})"; else fail "$1 missing — anarch-pkg add ${2:-$1}"; fi
}

printf '\e[1;35man4rch doctor\e[0m  %s\n' "$(cat "$LUMEN_PATH/VERSION" 2>/dev/null || echo dev)"

# an4rch Server: no desktop; the system, remote access and the tools.
if is_server; then
  section "Server"
  pass "an4rch Server (no desktop) · kernel $(uname -r)"
  for c in git curl jq fzf btop "${SHELL##*/}"; do need "$c"; done
  for s in NetworkManager sshd systemd-timesyncd; do
    if systemctl is-active -q "$s" 2>/dev/null; then pass "$s"; else note "$s not active — sudo systemctl enable --now $s"; fi
  done
  if systemctl is-active -q ufw 2>/dev/null; then pass "firewall active"; else note "firewall off — sudo systemctl enable --now ufw"; fi
  if [[ "$(findmnt -no FSTYPE / 2>/dev/null)" == btrfs ]] && has snapper && snapper -c root list >/dev/null 2>&1; then
    pass "system snapshots (snapper)"
  else
    note "no system snapshots"
  fi
  failed=$(systemctl --failed --no-legend 2>/dev/null | awk '{print $2}' | tr '\n' ' ')
  if [[ -z "${failed// /}" ]]; then pass "no failed services"; else note "failed services: $failed"; fi
  used=$(df -P / | awk 'NR==2 {print int($5)}')
  if ((used < 90)); then pass "disk ${used}% full"; else note "disk ${used}% full — free some space (anarch snapshot list, paccache -r)"; fi
  printf '\n%s passed, %s notes, %s problems\n' "$ok" "$warn" "$bad"
  [[ $bad -eq 0 ]]
  exit
fi

section "Core"
need hyprctl hyprland
if has hyprctl && hyprctl version -j >/dev/null 2>&1; then
  pass "Hyprland $(hyprctl version -j | jq -r '.tag // .version // "?"') running"
  errors=$(hyprctl configerrors 2>/dev/null | grep -v '^$' || true)
  if [[ -z "$errors" || "$errors" == "no errors" ]]; then pass "Hyprland config has no errors"; else fail "Hyprland config errors:"; printf '%s\n' "$errors" | sed 's/^/      /'; fi
else
  note "Hyprland is not running in this shell (run inside the desktop for live checks)"
fi
need uwsm uwsm
need waybar waybar
if has waybar; then
  wv=$(waybar --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)
  if [[ -n "$wv" ]] && [[ "$(printf '%s\n0.15.0\n' "$wv" | sort -V | tail -n1)" == "0.15.0" ]] && ! pacman -Q waybar-git >/dev/null 2>&1; then
    note "waybar $wv predates Hyprland's Lua IPC: workspace clicks won't work. Fix: anarch-pkg add waybar-git"
  fi
fi
for c in fuzzel mako hypridle hyprlock swaybg; do need "$c"; done
need hyprsunset hyprsunset optional
need hyprpicker hyprpicker optional

section "an4rch apps"
if python3 -c 'import gi; gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1")' 2>/dev/null; then
  pass "GTK 4 + libadwaita for Python (Start menu, App Store, Welcome)"
else
  fail "Python GTK 4 / libadwaita missing — anarch-pkg add python-gobject gtk4 libadwaita"
fi
if [[ -f /usr/lib/libgtk4-layer-shell.so ]]; then pass "gtk4-layer-shell (Start menu overlay)"; else note "gtk4-layer-shell missing: the Start menu opens as a normal window (anarch-pkg add gtk4-layer-shell)"; fi
if pgrep -f 'lumen-start/lumen_start.py' >/dev/null; then pass "Start menu service running"; else note "Start menu service not running — anarch-start --daemon"; fi
need flatpak flatpak optional
if [[ "$(findmnt -no FSTYPE / 2>/dev/null)" == btrfs ]]; then
  if has snapper && snapper -c root list >/dev/null 2>&1; then pass "system snapshots (snapper)"; else note "btrfs without snapper: no rollbacks (sudo bash ~/.local/share/lumen/install/distro.sh)"; fi
fi

section "Everyday tools"
for c in grim slurp wl-copy cliphist jq brightnessctl playerctl wpctl nmcli; do need "$c"; done
need satty satty optional
need wf-recorder wf-recorder optional
need tesseract "tesseract tesseract-data-eng" optional
need qalc libqalculate optional
need "$LUMEN_TERMINAL" "$LUMEN_TERMINAL"
need "$LUMEN_BROWSER" "$LUMEN_BROWSER"
need "${LUMEN_EDITOR%% *}" "${LUMEN_EDITOR%% *}" optional
need "${LUMEN_FILES%% *}" "${LUMEN_FILES%% *}" optional

section "Session"
for p in waybar mako hypridle swaybg; do
  if pgrep -x "$p" >/dev/null; then pass "$p running"; else note "$p not running — anarch-session start"; fi
done
if pgrep -f hyprpolkitagent >/dev/null || systemctl --user is-active -q hyprpolkitagent 2>/dev/null; then pass "authentication agent running"; else note "no polkit agent running (admin prompts won't appear)"; fi
if pgrep -f 'wl-paste.*cliphist' >/dev/null; then pass "clipboard history recording"; else note "clipboard history not recording"; fi
[[ -d "$LUMEN_CURRENT/theme" ]] && pass "theme: $(theme_current)" || fail "no theme rendered — anarch-theme set lumen"
[[ -e "$LUMEN_CURRENT/wallpaper" ]] && pass "wallpaper: $(basename "$(readlink "$LUMEN_CURRENT/wallpaper")")" || note "no wallpaper — anarch-wallpaper generate"

section "System services"
for s in NetworkManager bluetooth power-profiles-daemon; do
  if systemctl is-active -q "$s" 2>/dev/null; then
    pass "$s"
  elif [[ "$s" == bluetooth ]] && ! compgen -G '/sys/class/bluetooth/*' >/dev/null; then
    pass "bluetooth: no adapter in this computer"
  else
    note "$s not active — sudo systemctl enable --now $s"
  fi
done
for s in pipewire wireplumber; do
  if systemctl --user is-active -q "$s" 2>/dev/null; then pass "$s"; else fail "$s not active — systemctl --user enable --now $s"; fi
done
if systemctl is-enabled -q greetd 2>/dev/null; then pass "greetd login screen"; else note "no display manager; logging in on tty1 starts the desktop"; fi
if ! has ufw; then
  note "no firewall (anarch-pkg add ufw)"
elif systemctl is-active -q ufw 2>/dev/null || sudo -n ufw status 2>/dev/null | grep -q 'Status: active'; then
  pass "firewall active"
else
  note "firewall off — sudo ufw enable && sudo systemctl enable ufw"
fi

section "Apps"
applog="${XDG_STATE_HOME:-$HOME/.local/state}/lumen/apps.log"
if [[ -s "$applog" ]]; then
  note "apps that couldn't start recently (newest last):"
  tail -n 5 "$applog" | cut -c1-160 | sed 's/^/      /'
else
  pass "no app start-up errors"
fi

section "Fonts"
for f in "Inter" "JetBrainsMono Nerd Font"; do
  if fc-list | grep -qi "$f"; then pass "$f"; else fail "$f missing"; fi
done

printf '\n%s passed, %s notes, %s problems\n' "$ok" "$warn" "$bad"
[[ $bad -eq 0 ]]
