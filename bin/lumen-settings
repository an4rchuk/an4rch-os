#!/usr/bin/env bash
# lumen-settings — obsolete name (before An4rch OS 1.1.0) of anarch-settings; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-settings is obsolete: use anarch-settings (or: anarch settings)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-settings" "$@"
