#!/usr/bin/env bash
# lumen-remind — obsolete name (before an4rch OS 1.1.0) of anarch-remind; kept so old configs still work.
[[ -t 2 ]] && printf '\e[33m!\e[0m lumen-remind is obsolete: use anarch-remind (or: anarch remind)\n' >&2
exec "${LUMEN_PATH:-$HOME/.local/share/lumen}/bin/anarch-remind" "$@"
