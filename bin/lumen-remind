#!/usr/bin/env bash
# lumen-remind — reminders that pop up as notifications (SUPER + SHIFT + A).
#
#   lumen-remind                       ask with a prompt
#   lumen-remind 25m Stretch           in 25 minutes
#   lumen-remind 1h30m "Call Alex"     in an hour and a half
#   lumen-remind at 17:30 Leave        today (or tomorrow, if already past)
#   lumen-remind at "tomorrow 9:00" Standup
#   lumen-remind list                  show and cancel pending reminders
#   lumen-remind list --plain          print pending reminders
#
# Reminders are systemd user timers: they survive closing the terminal but
# not a reboot.
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

sound=/usr/share/sounds/freedesktop/stereo/complete.oga

schedule() {
  local when="$1" text="$2" seconds now target
  now=$(date +%s)
  if [[ "$when" =~ ^([0-9]+[smhd])+$ ]]; then
    seconds=0
    local part
    while read -r part; do
      [[ -z "$part" ]] && continue
      case "${part: -1}" in
        s) ((seconds += ${part%s})) ;;
        m) ((seconds += ${part%m} * 60)) ;;
        h) ((seconds += ${part%h} * 3600)) ;;
        d) ((seconds += ${part%d} * 86400)) ;;
      esac
    done < <(grep -oE '[0-9]+[smhd]' <<<"$when")
  else
    target=$(date -d "$when" +%s 2>/dev/null) || die "I don't understand the time '$when'"
    # "at 9:00" when it's already 10:00 means tomorrow.
    [[ $target -le $now && "$when" =~ ^[0-9]{1,2}:[0-9]{2}$ ]] && target=$(date -d "tomorrow $when" +%s)
    seconds=$((target - now))
  fi
  [[ $seconds -gt 0 ]] || die "That time is in the past"

  local unit="lumen-remind-$now-$RANDOM"
  local due
  due=$(date -d "@$((now + seconds))" '+%a %H:%M')
  systemd-run --user --quiet --collect --unit "$unit" --on-active="${seconds}s" \
    --description "Reminder: $text" \
    --setenv=DISPLAY="${DISPLAY:-}" --setenv=WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
    /bin/sh -c 'notify-send -a Reminder -u critical -i alarm-symbolic "Reminder" "$1"; [ -f "$2" ] && pw-play "$2" 2>/dev/null; true' \
    _ "$text" "$sound"
  bar_signal_reminders
  notify "Reminder set for $due" "$text" -i alarm-symbolic -t 3000
}

bar_signal_reminders() { pkill -RTMIN+13 waybar 2>/dev/null || true; }

list() {
  # Each line: unit<TAB>time-left<TAB>text
  systemctl --user list-timers --all --output=json 'lumen-remind-*' 2>/dev/null |
    jq -r --argjson now "$(date +%s%6N)" '.[] | select(.next != null) |
      "\(.activates)\t\(((.next - $now) / 60000000) | ceil)\t\(.unit)"' |
    while IFS=$'\t' read -r service minutes _timer; do
      desc=$(systemctl --user show -p Description --value "$service" | sed 's/^Reminder: //')
      printf '%s\t%s min\t%s\n' "${service%.service}" "$minutes" "$desc"
    done
}

case "${1:-}" in
  "")
    input=$(ask "󰀠" "25m Stretch  ·  at 17:30 Call Alex  ·  1h Tea") || exit 0
    [[ -n "$input" ]] || exit 0
    if [[ "$input" == at\ * ]]; then
      rest="${input#at }"
      # Accept "at 17:30 text" and "at tomorrow 9:00 text".
      if [[ "$rest" =~ ^((today|tomorrow|mon|tue|wed|thu|fri|sat|sun)[a-z]*\ )?[0-9]{1,2}:[0-9]{2} ]]; then
        when="${BASH_REMATCH[0]}"
        text="${rest#"$when"}"
      else
        die "Use: at 17:30 Something"
      fi
    else
      when="${input%% *}"
      text="${input#"$when"}"
    fi
    text="${text# }"
    schedule "$when" "${text:-Reminder}"
    ;;
  list)
    mapfile -t rows < <(list)
    plain=0
    [[ "${2:-}" == --plain || -t 1 ]] && plain=1
    if [[ ${#rows[@]} -eq 0 ]]; then
      [[ $plain -eq 1 ]] || notify "No reminders" "Set one with SUPER + SHIFT + A" -i alarm-symbolic
      exit 0
    fi
    if [[ $plain -eq 1 ]]; then
      printf '%s\n' "${rows[@]}" | cut -f2- | column -t -s $'\t'
      exit 0
    fi
    choice=$(for r in "${rows[@]}"; do IFS=$'\t' read -r _ left text <<<"$r"; printf '󰀠  %s  ·  in %s\n' "$text" "$left"; done |
      menu "Cancel reminder" --index --width 50 --lines "${#rows[@]}") || exit 0
    unit=$(cut -f1 <<<"${rows[$choice]}")
    systemctl --user stop "$unit.timer" "$unit.service" 2>/dev/null || true
    bar_signal_reminders
    notify "Reminder cancelled" "" -i alarm-symbolic -t 2000
    ;;
  at)
    shift
    when="${1:?usage: lumen-remind at TIME TEXT}"
    shift
    schedule "$when" "${*:-Reminder}"
    ;;
  -h | --help | help) sed -n '2,14s/^# \{0,1\}//p' "$0" ;;
  *)
    when="$1"
    shift
    schedule "$when" "${*:-Reminder}"
    ;;
esac
