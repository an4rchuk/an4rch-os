#!/usr/bin/env bash
# anarch-record — record the screen or a region to video (SUPER + SHIFT + R).
#
#   anarch-record region | screen     start (or stop, if already recording)
#   anarch-record stop
#   anarch-record region --audio      include desktop audio
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

pidfile="$LUMEN_STATE/recording.pid"
mkdir -p "$LUMEN_STATE" "$LUMEN_RECORDING_DIR"

stop() {
  if pgrep -x wf-recorder >/dev/null; then
    pkill -INT -x wf-recorder
    for _ in {1..30}; do pgrep -x wf-recorder >/dev/null || break; sleep 0.1; done
    file=$(cat "$LUMEN_STATE/recording.file" 2>/dev/null || true)
    rm -f "$pidfile"
    bar_signal record
    if [[ -n "$file" && -f "$file" ]]; then
      (
        action=$(notify-send -a An4rch -i video-x-generic -A "open=Play" -A "folder=Show in folder" \
          "Recording saved" "${file/#$HOME/\~}" 2>/dev/null || true)
        case "$action" in
          open) launch xdg-open "$file" ;;
          folder) launch xdg-open "$LUMEN_RECORDING_DIR" ;;
        esac
      ) >/dev/null 2>&1 &
      disown
    fi
    return 0
  fi
  return 1
}

mode="${1:-region}"
[[ "$mode" == stop ]] && { stop || true; exit 0; }
stop && exit 0 # second press stops the recording

has wf-recorder || die "wf-recorder is not installed (anarch-pkg add wf-recorder)"

file="$LUMEN_RECORDING_DIR/Recording-$(date +%Y-%m-%d_%H-%M-%S).mp4"
args=(-f "$file")
[[ "${2:-}" == --audio ]] && args+=(--audio)

case "$mode" in
  region)
    geometry=$(slurp -d -b '#00000055' -c '#ffffffcc' -w 2 2>/dev/null) || exit 0
    args+=(-g "$geometry")
    ;;
  screen)
    args+=(-o "$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name')")
    ;;
  *) die "usage: anarch-record region|screen|stop [--audio]" ;;
esac

printf '%s\n' "$file" >"$LUMEN_STATE/recording.file"
setsid -f wf-recorder "${args[@]}" >/dev/null 2>&1
sleep 0.3
pgrep -x wf-recorder >"$pidfile" || die "Recording failed to start"
bar_signal record
notify "Recording" "Press the same keys again, or click the red dot, to stop." -t 2500 -i media-record
