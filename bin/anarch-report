#!/usr/bin/env bash
# anarch-report — collect what's needed to fix a problem into one file, with
# your private details removed, ready to attach to a bug report.
#
#   anarch-report          write ~/an4rch-report-<date>.txt and open a new
#                          issue on GitHub to attach it to
#   anarch-report --print  print the report instead
#
# Included: an4rch's version and install choices, the kernel, the graphics,
# network and sound hardware, disks and free space, failed services, errors
# from this boot, `anarch doctor`, and an4rch's own logs. Removed: your user
# and computer names, your home folder's path, network addresses, Wi-Fi
# names and email addresses. Read it before you send it.
set -uo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

ISSUES="https://github.com/an4rchuk/an4rch-os/issues/new"

section() { printf '\n===== %s =====\n' "$1"; }
run() { "$@" 2>&1 | tail -n "${LINES_MAX:-80}"; }

collect() {
  section "an4rch"
  echo "version: $(cat "$LUMEN_PATH/VERSION" 2>/dev/null || echo dev)"
  echo "git: $(git -C "$LUMEN_PATH" log -1 --format='%h %cs' 2>/dev/null || echo none)"
  sed 's/^/install: /' /etc/lumen/install.conf 2>/dev/null
  echo "theme: $(theme_current 2>/dev/null)"
  section "System"
  uname -srm
  grep -E '^(PRETTY_NAME|VERSION_ID)=' /etc/os-release
  echo "boot: $([[ -d /sys/firmware/efi ]] && echo UEFI || echo BIOS)"
  run cat /proc/cmdline
  echo "uptime: $(uptime -p 2>/dev/null)"
  section "Hardware"
  run lscpu | grep -E 'Model name|^CPU\(s\)'
  free -h | head -n 2
  lspci -nnk 2>/dev/null | grep -A3 -Ei 'vga|3d controller|display|network|ethernet|audio' | head -n 60
  section "Displays"
  hyprctl monitors 2>/dev/null | grep -E '^Monitor|^\s+[0-9]+x[0-9]+|scale' | head -n 20
  section "Disks"
  lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS 2>/dev/null
  df -h / /home 2>/dev/null
  section "Failed services"
  systemctl --failed --no-legend --plain 2>/dev/null
  systemctl --user --failed --no-legend --plain 2>/dev/null
  section "Errors this boot"
  LINES_MAX=120 run journalctl -b -p err --no-pager -q
  section "anarch doctor"
  LINES_MAX=120 run "$LUMEN_PATH/bin/anarch-doctor"
  local f
  for f in apps.log session.log titlebars.log; do
    [[ -f "$LUMEN_STATE/$f" ]] || continue
    section "$f"
    tail -n 60 "$LUMEN_STATE/$f"
  done
}

# scrub — remove private details from the report on stdin.
scrub() {
  local me host home ssids
  me=$(id -un) host=$(hostnamectl hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || hostname)
  home=$HOME
  ssids=$(nmcli -t -f NAME connection show 2>/dev/null | grep -v '^lo$' || true)
  python3 -c '
import re, sys
text = sys.stdin.read()
home, me, host = sys.argv[1], sys.argv[2], sys.argv[3]
for ssid in [s for s in sys.argv[4].splitlines() if len(s) > 2]:
    text = text.replace(ssid, "<network>")
text = text.replace(home, "~")
for word, repl in ((me, "<user>"), (host, "<computer>")):
    if len(word) > 1:
        text = re.sub(r"\b" + re.escape(word) + r"\b", repl, text)
text = re.sub(r"\b([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}\b", "<mac>", text)
text = re.sub(r"\b(?:\d{1,3}\.){3}\d{1,3}\b", "<ip>", text)
text = re.sub(r"\b(?:[0-9a-fA-F]{1,4}:){3,7}[0-9a-fA-F]{1,4}\b", "<ip6>", text)
text = re.sub(r"[\w.+-]+@[\w-]+\.[\w.-]+", "<email>", text)
text = re.sub(r"(?i)(serial[ _]?(number)?\s*[:=]\s*)\S+", r"\1<serial>", text)
sys.stdout.write(text)
' "$home" "$me" "$host" "$ssids"
}

report=$(collect | scrub)
if [[ "${1:-}" == --print ]]; then
  printf '%s\n' "$report"
  exit 0
fi
case "${1:-}" in -h | --help | help) sed -n '2,13s/^# \{0,1\}//p' "$0"; exit 0 ;; esac

out="$HOME/an4rch-report-$(date +%Y-%m-%d-%H%M).txt"
printf '%s\n' "$report" >"$out"
echo "✓ Report saved: ${out/#$HOME/\~} ($(wc -l <"$out") lines, private details removed: read it before sending)"
title="Problem: (describe it briefly)"
body=$'**What happened?**\n\n\n**What did you expect?**\n\n\n**Steps to make it happen again**\n1. \n\n'"an4rch $(cat "$LUMEN_PATH/VERSION" 2>/dev/null). Report attached: ${out##*/}"
url="$ISSUES?title=$(python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$title")&body=$(python3 -c 'import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$body")"
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
  launch xdg-open "$url"
  launch xdg-open "$(dirname "$out")"
  echo "→ A new issue is open in your browser: drag the report file into it."
else
  echo "→ Open a new issue and attach the file: $ISSUES"
fi
