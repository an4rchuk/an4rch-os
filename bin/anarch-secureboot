#!/usr/bin/env bash
# anarch-secureboot — turn Secure Boot on (needed by some anti-cheat games and
# work laptops) with your own keys.
#
#   anarch-secureboot            is Secure Boot on, and is everything signed?
#   anarch-secureboot setup      sign An4rch's boot files with your own keys and
#                                enrol them (with Microsoft's, so Windows and
#                                graphics cards keep working)
#   anarch-secureboot firmware   restart into the firmware settings
#
# How it goes: 1) restart into the firmware settings, find Secure Boot and
# choose "Reset to Setup Mode" (or "Clear keys"; leave Secure Boot off for now),
# 2) back in An4rch run `anarch-secureboot setup`, 3) restart into the
# firmware again and turn Secure Boot on. Updates sign themselves after that.
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

uefi() { [[ -d /sys/firmware/efi ]] || die "This computer started in legacy BIOS mode, which has no Secure Boot."; }

sbjson() { sudo sbctl status --json 2>/dev/null; }
field() { python3 -c 'import json,sys; d=json.load(sys.stdin); print(str(d.get(sys.argv[1], "")).lower())' "$1"; }

# Files to sign: the boot loaders on the EFI partition and every kernel.
boot_files() {
  local esp boot f
  esp=$(bootctl --print-esp-path 2>/dev/null || echo /efi)
  boot=$(bootctl --print-boot-path 2>/dev/null || echo /boot)
  for f in "$esp/EFI/systemd/systemd-bootx64.efi" "$esp/EFI/BOOT/BOOTX64.EFI" "$boot"/vmlinuz-*; do
    sudo test -f "$f" && echo "$f"
  done
}

status() {
  uefi
  has sbctl || { echo "Secure Boot: $(secure_state). Set it up with: anarch secureboot setup"; return 0; }
  local j
  j=$(sbjson) || { echo "Secure Boot: $(secure_state)"; return 0; }
  echo "Secure Boot:   $(field secure_boot <<<"$j" | sed 's/true/on/; s/false/off/')"
  echo "Setup mode:    $(field setup_mode <<<"$j" | sed 's/true/yes (ready for your keys)/; s/false/no/')"
  echo "Your keys:     $(field installed <<<"$j" | sed 's/true/made/; s/false/not made yet/')"
  echo
  sudo sbctl verify 2>/dev/null | sed 's/^/  /' || true
}

secure_state() {
  local v
  v=$(od -An -t u1 /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | awk '{print $NF}')
  case "$v" in 1) echo on ;; 0) echo off ;; *) echo unknown ;; esac
}

setup() {
  uefi
  in_terminal "$0" setup
  need sbctl
  local j
  j=$(sbjson) || die "sbctl couldn't read the firmware's Secure Boot state."
  if [[ "$(field setup_mode <<<"$j")" != true ]]; then
    cat <<'EOF'
The firmware isn't ready for your keys yet (it isn't in "Setup Mode").

  1. Restart into the firmware settings:  anarch secureboot firmware
  2. Find Secure Boot (often under Security or Boot) and choose
     "Reset to Setup Mode", "Clear Secure Boot keys" or "Delete all keys".
     Leave Secure Boot itself off for now. Save and exit.
  3. Back in An4rch, run:  anarch secureboot setup
EOF
    exit 1
  fi
  if [[ "$(field installed <<<"$j")" != true ]]; then
    echo "• Making your keys"
    sudo sbctl create-keys >/dev/null
  fi
  echo "• Enrolling them (with Microsoft's, for Windows and graphics cards)"
  sudo sbctl enroll-keys --microsoft >/dev/null || die "The firmware refused the keys. Put it in Setup Mode again and retry."
  local f n=0
  while read -r f; do
    [[ -n "$f" ]] || continue
    sudo sbctl sign -s "$f" >/dev/null && n=$((n + 1))
  done < <(boot_files)
  echo "• Signed $n boot files (updates re-sign them by themselves)"
  sudo sbctl verify | sed 's/^/  /' || true
  echo
  echo "✓ Ready. Last step: restart into the firmware (anarch secureboot firmware),"
  echo "  turn Secure Boot on, save and exit."
}

case "${1:-}" in
  "" | status) status ;;
  setup) setup ;;
  firmware) systemctl reboot --firmware-setup ;;
  -h | --help | help) sed -n '2,14s/^# \{0,1\}//p' "$0" ;;
  *) die "Unknown command '$1'. See: anarch-secureboot --help" ;;
esac
