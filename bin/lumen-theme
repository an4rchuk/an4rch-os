#!/usr/bin/env bash
# lumen-theme — list, preview, switch and create themes.
#
#   lumen-theme                 pick a theme from a menu
#   lumen-theme set NAME        switch to NAME
#   lumen-theme next            cycle to the next theme
#   lumen-theme list            print available themes
#   lumen-theme current         print the active theme
#   lumen-theme render          re-render the active theme (after editing it)
#   lumen-theme new NAME        copy the active theme to ~/.config/lumen/themes/NAME
#   lumen-theme install URL     install a theme from a git repository and switch to it
#   lumen-theme remove NAME     remove an installed theme
#   lumen-theme packs           list the theme packs you can add
#   lumen-theme get PACK|NAME   add a theme pack (or one theme from one), with wallpapers
#   lumen-theme drop PACK       remove a theme pack's themes
set -euo pipefail
source "${LUMEN_PATH:-$HOME/.local/share/lumen}/lib/lumen.sh"

TEMPLATES="$LUMEN_PATH/templates"

# render NAME DEST — write every template for theme NAME into DEST.
render() {
  local name="$1" dest="$2" dir
  dir=$(theme_dir "$name") || die "No theme called '$name'. Try: lumen-theme list"

  declare -A c=()
  local key value
  while IFS='=' read -r key value; do
    key="${key//[[:space:]]/}"
    [[ -z "$key" || "$key" == \#* ]] && continue
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    c[$key]="$value"
  done <"$dir/theme.conf"

  local required
  for required in bg bg_alt bg_hl fg fg_dim accent red orange yellow green cyan blue purple; do
    [[ -n "${c[$required]:-}" ]] || die "$dir/theme.conf is missing '$required'"
  done

  # Derived values. Any of them can be set explicitly in theme.conf instead.
  : "${c[mode]:=dark}"
  : "${c[accent2]:=${c[blue]}}"
  : "${c[accent_fg]:=${c[bg]}}"
  : "${c[term_black]:=${c[bg_hl]}}"
  : "${c[term_bright_black]:=${c[fg_dim]}}"
  : "${c[term_white]:=${c[fg]}}"
  : "${c[term_bright_white]:=${c[fg]}}"
  if [[ "${c[mode]}" == light ]]; then
    : "${c[color_scheme]:=prefer-light}" "${c[gtk_theme]:=adw-gtk3}" "${c[icon_theme]:=Papirus-Light}"
  else
    : "${c[color_scheme]:=prefer-dark}" "${c[gtk_theme]:=adw-gtk3-dark}" "${c[icon_theme]:=Papirus-Dark}"
  fi
  c[slug]="$name"
  c[home]="$HOME"

  # One sed program substitutes {{key}}, {{key.hex}} (no '#') and
  # {{key.rgb}} ("r, g, b") for every palette entry.
  local script="" hex
  for key in "${!c[@]}"; do
    value="${c[$key]//\\/\\\\}"
    value="${value//|/\\|}"
    value="${value//&/\\&}"
    script+="s|{{$key}}|$value|g;"
    if [[ "${c[$key]}" =~ ^#([0-9a-fA-F]{6})$ ]]; then
      hex="${BASH_REMATCH[1]}"
      script+="s|{{$key.hex}}|$hex|g;"
      script+="s|{{$key.rgb}}|$((16#${hex:0:2})), $((16#${hex:2:2})), $((16#${hex:4:2}))|g;"
    fi
  done

  mkdir -p "$dest"
  local tpl out
  for tpl in "$TEMPLATES"/*.tpl; do
    out="$(basename "${tpl%.tpl}")"
    if [[ -f "$dir/overrides/$out" ]]; then
      cp "$dir/overrides/$out" "$dest/$out"
    else
      sed -e "$script" "$tpl" >"$dest/$out"
    fi
  done
  # Overrides may also add files no template knows about.
  if [[ -d "$dir/overrides" ]]; then
    for out in "$dir"/overrides/*; do
      [[ -f "$out" && ! -e "$dest/$(basename "$out")" ]] && cp "$out" "$dest/"
    done
  fi
  if grep -l '{{' "$dest"/* 2>/dev/null | head -n1 | grep -q .; then
    echo "warning: unresolved placeholders in: $(grep -l '{{' "$dest"/* | xargs -n1 basename | tr '\n' ' ')" >&2
  fi
  printf '%s\n' "$name" >"$dest/../theme.name.new"
}

# apply — tell every running component to pick up the new files.
apply() {
  local t="$LUMEN_CURRENT/theme"

  # theme.env carries the derived GTK/icon settings for this palette.
  local LUMEN_THEME_COLOR_SCHEME="" LUMEN_THEME_GTK="" LUMEN_THEME_ICONS=""
  # shellcheck source=/dev/null
  source "$t/theme.env"
  if has gsettings; then
    gsettings set org.gnome.desktop.interface color-scheme "$LUMEN_THEME_COLOR_SCHEME" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme "$LUMEN_THEME_GTK" 2>/dev/null || true
    gsettings set org.gnome.desktop.interface icon-theme "$LUMEN_THEME_ICONS" 2>/dev/null || true
  fi

  has hyprctl && hyprctl reload >/dev/null 2>&1 || true
  pkill -SIGUSR2 -x waybar 2>/dev/null || true
  has makoctl && makoctl reload 2>/dev/null || true
  pkill -SIGUSR2 -x ghostty 2>/dev/null || true
  pkill -SIGUSR2 -x btop 2>/dev/null || true

  # Point btop at the rendered theme (btop rewrites its config, so patch it).
  local btop="${XDG_CONFIG_HOME:-$HOME/.config}/btop/btop.conf"
  if [[ -f "$btop" ]]; then
    sed -i "s|^color_theme = .*|color_theme = \"$t/btop.theme\"|" "$btop"
  fi

  "$LUMEN_PATH/bin/lumen-wallpaper" theme >/dev/null 2>&1 || true
  # The login screen follows the theme and wallpaper.
  "$LUMEN_PATH/bin/lumen-login" sync >/dev/null 2>&1 || true
}

set_theme() {
  local name="$1"
  # The signature theme was called "lumen" before 1.1.0.
  [[ "$name" == lumen && ! -f "$LUMEN_CONFIG/themes/lumen/theme.conf" ]] && name=$DEFAULT_THEME
  theme_dir "$name" >/dev/null || die "No theme called '$name'. Try: lumen-theme list"
  mkdir -p "$LUMEN_CURRENT"
  rm -rf "$LUMEN_CURRENT/theme.new"
  render "$name" "$LUMEN_CURRENT/theme.new"
  # Swap directories so readers never see a half-written theme.
  rm -rf "$LUMEN_CURRENT/theme.old"
  [[ -d "$LUMEN_CURRENT/theme" ]] && mv "$LUMEN_CURRENT/theme" "$LUMEN_CURRENT/theme.old"
  mv "$LUMEN_CURRENT/theme.new" "$LUMEN_CURRENT/theme"
  mv "$LUMEN_CURRENT/theme.name.new" "$LUMEN_CURRENT/theme.name"
  rm -rf "$LUMEN_CURRENT/theme.old"
  apply "$name"
  notify "Theme: $(theme_get "$name" name || echo "$name")" "Everything has been restyled." -i preferences-desktop-theme -h string:x-canonical-private-synchronous:lumen-theme
}

PACKS="$LUMEN_PATH/themes-extra"

pack_get() {
  local f="$PACKS/$1/pack.conf"
  sed -n -E "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*(.*[^[:space:]])[[:space:]]*\$/\1/p" "$f" 2>/dev/null | head -n1
}

# The size to paint wallpapers at: the largest screen, or 2560x1440.
screen_size() {
  local s=""
  if has hyprctl && has jq; then
    s=$(hyprctl monitors -j 2>/dev/null | jq -r 'max_by(.width * .height) | "\(.width)x\(.height)"' 2>/dev/null || true)
  fi
  [[ "$s" =~ ^[0-9]{3,5}x[0-9]{3,5}$ ]] && echo "$s" || echo 2560x1440
}

list_packs() {
  local d name n added
  for d in "$PACKS"/*/pack.conf; do
    [[ -f "$d" ]] || continue
    d=$(dirname "$d")
    name=$(basename "$d")
    n=0 added=0
    for t in "$d"/*/theme.conf; do
      [[ -f "$t" ]] || continue
      n=$((n + 1))
      [[ -f "$LUMEN_CONFIG/themes/$(basename "$(dirname "$t")")/.pack" ]] && added=$((added + 1))
    done
    printf '\e[1m%s\e[0m (%s): %s\n' "$name" "$(pack_get "$name" name)" "$(pack_get "$name" description)"
    if ((added == n)); then
      printf '  added: all %s themes. Remove with: anarch theme drop %s\n' "$n" "$name"
    else
      printf '  %s themes. Add with: anarch theme get %s\n' "$n" "$name"
    fi
  done
}

# get PACK|THEME — copy the themes in, paint their wallpapers.
get_themes() {
  local want="$1" dirs=() d slug size i=0
  if [[ -f "$PACKS/$want/pack.conf" ]]; then
    for d in "$PACKS/$want"/*/; do [[ -f "$d/theme.conf" ]] && dirs+=("${d%/}"); done
  else
    for d in "$PACKS"/*/"$want"; do [[ -f "$d/theme.conf" ]] && dirs+=("$d"); done
  fi
  ((${#dirs[@]})) || die "No theme pack or pack theme called '$want'. See: anarch theme packs"
  size=$(screen_size)
  mkdir -p "$LUMEN_CONFIG/themes"
  for d in "${dirs[@]}"; do
    i=$((i + 1))
    slug=$(basename "$d")
    printf '  [%s/%s] %s\n' "$i" "${#dirs[@]}" "$(sed -n -E 's/^name[[:space:]]*=[[:space:]]*//p' "$d/theme.conf" | head -n1)"
    rm -rf "${LUMEN_CONFIG:?}/themes/$slug"
    cp -r "$d" "$LUMEN_CONFIG/themes/$slug"
    basename "$(dirname "$d")" >"$LUMEN_CONFIG/themes/$slug/.pack"
    if has python3; then
      python3 "$LUMEN_PATH/bin/lumen-wallgen" --theme "$slug" --size "$size" --out "$LUMEN_WALLPAPERS" >/dev/null 2>&1 ||
        echo "    (couldn't paint its wallpapers; the theme still works)"
    fi
  done
  if ((${#dirs[@]} == 1)); then
    set_theme "$(basename "${dirs[0]}")"
  else
    local first
    first=$(pack_get "$want" first)
    echo "Added ${#dirs[@]} themes. Pick one with SUPER + CTRL + T (or: anarch theme), or try: anarch theme set ${first:-$(basename "${dirs[0]}")}"
    notify "Themes added" "${#dirs[@]} new themes: pick one with ⊞ + CTRL + T." -i preferences-desktop-theme
  fi
}

drop_pack() {
  local want="$1" d slug n=0 cur
  cur=$(theme_current)
  for d in "$LUMEN_CONFIG"/themes/*/.pack; do
    [[ -f "$d" && "$(cat "$d")" == "$want" ]] || continue
    slug=$(basename "$(dirname "$d")")
    [[ "$slug" == "$cur" ]] && set_theme "$DEFAULT_THEME"
    rm -rf "${LUMEN_CONFIG:?}/themes/$slug" "${LUMEN_WALLPAPERS:?}/$slug"
    n=$((n + 1))
  done
  ((n)) || die "No themes from a pack called '$want' are installed"
  echo "Removed $n themes."
}

pick() {
  local current choice names=() labels=() n
  current=$(theme_current)
  while read -r n; do
    names+=("$n")
    if [[ "$n" == "$current" ]]; then
      labels+=("  $(theme_get "$n" name)  ·  current")
    else
      labels+=("  $(theme_get "$n" name)")
    fi
  done < <(theme_list)
  choice=$(printf '%s\n' "${labels[@]}" | menu "Theme" --index --lines "${#names[@]}" --width 36) || exit 0
  if [[ -n "$choice" ]]; then set_theme "${names[$choice]}"; fi
}

case "${1:-pick}" in
  pick) pick ;;
  set) set_theme "${2:?usage: lumen-theme set NAME}" ;;
  list) theme_list ;;
  current) theme_current ;;
  render) set_theme "$(theme_current)" ;;
  next)
    mapfile -t all < <(theme_list)
    cur=$(theme_current)
    for i in "${!all[@]}"; do
      if [[ "${all[$i]}" == "$cur" ]]; then
        set_theme "${all[$(((i + 1) % ${#all[@]}))]}"
        exit 0
      fi
    done
    set_theme "${all[0]}"
    ;;
  new)
    new="${2:?usage: lumen-theme new NAME}"
    src=$(theme_dir "$(theme_current)")
    mkdir -p "$LUMEN_CONFIG/themes"
    [[ -e "$LUMEN_CONFIG/themes/$new" ]] && die "$LUMEN_CONFIG/themes/$new already exists"
    cp -r "$src" "$LUMEN_CONFIG/themes/$new"
    sed -i -E "s/^(name[[:space:]]*=).*/\1 $new/" "$LUMEN_CONFIG/themes/$new/theme.conf"
    echo "Created $LUMEN_CONFIG/themes/$new — edit theme.conf, then run: lumen-theme set $new"
    ;;
  install)
    url="${2:?usage: lumen-theme install GIT-URL}"
    has git || die "git is needed to install themes"
    name=$(basename "${url%/}" .git)
    name="${name#lumen-}"
    name="${name%-theme}"
    name=$(tr '[:upper:]' '[:lower:]' <<<"$name" | tr -cd 'a-z0-9-')
    [[ -n "$name" ]] || die "Couldn't work out a theme name from $url"
    dest="$LUMEN_CONFIG/themes/$name"
    mkdir -p "$LUMEN_CONFIG/themes"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    git clone -q --depth 1 "$url" "$tmp/theme" || die "Couldn't download $url"
    [[ -f "$tmp/theme/theme.conf" ]] || die "$url has no theme.conf, so it isn't a an4rch theme (see: anarch manual themes)"
    rm -rf "$dest"
    mv "$tmp/theme" "$dest"
    # Themes without their own wallpapers get painted ones.
    if [[ ! -d "$dest/backgrounds" ]] && has python3; then
      python3 "$LUMEN_PATH/bin/lumen-wallgen" --theme "$name" --out "$LUMEN_WALLPAPERS" >/dev/null 2>&1 || true
    fi
    echo "Installed '$name'. Update it later by running the same command again."
    set_theme "$name"
    ;;
  packs) list_packs ;;
  get) get_themes "${2:?usage: lumen-theme get PACK|NAME   (see: lumen-theme packs)}" ;;
  drop) drop_pack "${2:?usage: lumen-theme drop PACK}" ;;
  remove)
    name="${2:?usage: lumen-theme remove NAME}"
    [[ -d "$LUMEN_CONFIG/themes/$name" ]] || die "'$name' isn't an installed theme (bundled themes can't be removed)"
    [[ "$(theme_current)" == "$name" ]] && set_theme "$DEFAULT_THEME"
    rm -rf "${LUMEN_CONFIG:?}/themes/$name" "${LUMEN_WALLPAPERS:?}/$name"
    echo "Removed '$name'."
    ;;
  -h | --help | help) sed -n '2,16s/^# \{0,1\}//p' "$0" ;;
  *) die "Unknown command '$1'. See: lumen-theme --help" ;;
esac
